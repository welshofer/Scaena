<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Scaena.app may reach, and nothing else (the 20261024 plan's SEC-4): its own container; the
     decks, pictures, data, and sources a person opens or saves through the system's panels and the
     Finder; the providers and pages it calls with the person's key; and the remote's listener on the
     local network (SPEC §9.5). Signed with the hardened runtime by apps/mac/sign.sh. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
