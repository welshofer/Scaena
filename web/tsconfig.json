{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@scaena/wasm": ["../crates/scaena-wasm/www/pkg/scaena_wasm.d.ts"] }
  },
  "include": ["src"],
  "exclude": ["src/worker.ts"]
}
