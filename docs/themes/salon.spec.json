{
  "name": "Salon",
  "description": "Gallery white, ink black, one cobalt accent: Instrument Serif headlines set large over Inter. The same roles, layouts, and presets as Dusk and Daybreak: a deck moves between them by swapping the file.",
  "mode": "light",
  "colors": {
    "ink": "#151515",
    "paper": "#FCFCFA",
    "paper-2": "#F1F1EC",
    "accent": "#2340D9",
    "accent-2": "#D9481F",
    "muted": "#66665F",
    "line": "#E0E0D8"
  },
  "data": {
    "categorical": [
      "#1F1F1F",
      "#5E5E58",
      "#8E8E86",
      "#B9B9B0"
    ],
    "sequential": [
      "#EDEFFB",
      "#C3CBF3",
      "#8797EA",
      "#4A62DF",
      "#2340D9"
    ],
    "diverging": [
      "#D9481F",
      "#F1F1EC",
      "#2340D9"
    ]
  },
  "families": {
    "display": {
      "family": "Instrument Serif",
      "file": "fonts/InstrumentSerif-Regular.ttf",
      "italic": {
        "file": "fonts/InstrumentSerif-Italic.ttf"
      },
      "fallback": [
        "body"
      ]
    },
    "body": {
      "family": "Inter",
      "file": "fonts/Inter-VF.ttf",
      "axes": {
        "wght": [
          100,
          900
        ],
        "opsz": [
          14,
          32
        ]
      },
      "italic": {
        "file": "fonts/Inter-Italic-VF.ttf",
        "axes": {
          "wght": [
            100,
            900
          ],
          "opsz": [
            14,
            32
          ]
        }
      },
      "features": {
        "cv11": true,
        "ss01": false
      }
    },
    "mono": {
      "family": "JetBrains Mono",
      "file": "fonts/JetBrainsMono-VF.ttf",
      "axes": {
        "wght": [
          100,
          800
        ]
      },
      "italic": {
        "file": "fonts/JetBrainsMono-Italic-VF.ttf",
        "axes": {
          "wght": [
            100,
            800
          ]
        }
      }
    }
  },
  "voice": "gallery",
  "margin": [
    96,
    120
  ],
  "shaders": {
    "palettes": {
      "ambient": [
        "#FCFCFA",
        "#EEF0F7",
        "#DCE2F6",
        "#BAC5EF"
      ],
      "texture": [
        "#FCFCFA",
        "#F1F0EA",
        "#E4E2D9",
        "#C8C5BA"
      ]
    },
    "presets": {
      "backdrop": {
        "params": {
          "points": 4,
          "drift": 0.08,
          "softness": 0.9,
          "grain": 0.025
        }
      }
    }
  },
  "code": {
    "card": {
      "shadow": "soft"
    },
    "focus": {
      "dim": 0.55,
      "band": "paper"
    }
  }
}
