  "motion": {
    "durations": {
      "fast": 180,
      "standard": 420,
      "slow": 800
    },
    "easings": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "in": [
        0.4,
        0,
        1,
        1
      ],
      "out": [
        0,
        0,
        0.2,
        1
      ],
      "linear": [
        0,
        0,
        1,
        1
      ]
    },
    "springs": {
      "snappy": {
        "stiffness": 420,
        "damping": 34,
        "mass": 1
      },
      "gentle": {
        "stiffness": 170,
        "damping": 26,
        "mass": 1
      }
    },
    "presets": {
      "fade": {
        "from": {
          "opacity": 0
        },
        "duration": "standard",
        "ease": "out",
        "description": "Opacity only."
      },
      "rise": {
        "from": {
          "opacity": 0,
          "transform": {
            "translate": [
              0,
              24
            ]
          }
        },
        "duration": "standard",
        "ease": "out",
        "description": "Fade up from 24cu below."
      },
      "grow": {
        "from": {
          "transform": {
            "scale": [
              1,
              0
            ],
            "anchor": [
              0.5,
              1
            ]
          }
        },
        "spring": "snappy",
        "split": "marks",
        "stagger": 40,
        "description": "Bars grow from their baseline."
      },
      "draw": {
        "from": {
          "params": {
            "progress": 0
          }
        },
        "duration": "slow",
        "ease": "standard",
        "description": "A shape's outline draws on from where it starts."
      },
      "words": {
        "from": {
          "opacity": 0,
          "transform": {
            "translate": [
              0,
              12
            ]
          }
        },
        "split": "words",
        "stagger": 28,
        "ease": "out",
        "duration": "fast",
        "description": "Word-by-word rise."
      },
      "pulse": {
        "to": {
          "transform": {
            "scale": 1.04
          }
        },
        "spring": "gentle",
        "description": "Emphasis: a single soft pulse."
      }
    },
    "maxConcurrent": 12,
    "maxBuild": 2500
  },
