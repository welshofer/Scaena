  "spine": {
    "sections": [
      {
        "id": "opening",
        "title": "Opening",
        "beats": [
          {
            "id": "open",
            "claim": "The Ridgeline pilot worked, and the case to expand is strong.",
            "states": [
              "cover"
            ],
            "notes": "Frame the vote: one decision next Tuesday."
          }
        ]
      },
      {
        "id": "growth-section",
        "title": "Growth",
        "beats": [
          {
            "id": "growth",
            "claim": "Monthly trips grew from 4,200 in January to 18,900 in December.",
            "evidence": [
              "@rides"
            ],
            "states": [
              "growth",
              "total"
            ]
          },
          {
            "id": "hilltop-stalled",
            "claim": "Hilltop, the steepest neighborhood, barely moved until June.",
            "evidence": [
              "@rides"
            ],
            "states": [
              "hoods"
            ]
          }
        ]
      },
      {
        "id": "hilltop-section",
        "title": "E-bikes",
        "beats": [
          {
            "id": "ebikes",
            "claim": "E-bikes arrived in June, and Hilltop trips grew sixfold by December.",
            "evidence": [
              "@rides"
            ],
            "states": [
              "ebikes",
              "sixfold"
            ]
          },
          {
            "id": "lesson",
            "claim": "E-bikes unlock steep neighborhoods.",
            "states": [
              "lesson"
            ]
          }
        ]
      },
      {
        "id": "cost-section",
        "title": "Cost",
        "beats": [
          {
            "id": "cheaper",
            "claim": "By December a bike trip cost about $1.20 to run, against $2.90 for the bus.",
            "states": [
              "cost"
            ]
          },
          {
            "id": "setup",
            "claim": "The $1.4 million set-up cost bought a system that now runs cheaply.",
            "states": [
              "setup"
            ]
          }
        ]
      },
      {
        "id": "ask-section",
        "title": "The ask",
        "beats": [
          {
            "id": "recap",
            "claim": "Demand, cost, and proof all point to expanding.",
            "states": [
              "recap"
            ]
          },
          {
            "id": "proposal",
            "claim": "The proposal is two more neighborhoods in 2027.",
            "states": [
              "plan"
            ]
          },
          {
            "id": "ask",
            "claim": "Approve $1.2 million to expand to two more neighborhoods in 2027.",
            "states": [
              "ask"
            ],
            "notes": "End on the ask. Vote is next Tuesday."
          }
        ]
      }
    ]
