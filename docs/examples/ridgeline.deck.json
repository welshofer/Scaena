  "states": [
    {
      "id": "cover",
      "mode": "absolute",
      "layout": "title",
      "transition": "standard",
      "props": {
        "cover-kicker": {},
        "cover-title": {},
        "cover-sub": {}
      },
      "choreography": [
        {
          "sequence": [
            {
              "target": "cover-title",
              "enter": "rise"
            },
            {
              "target": "cover-sub",
              "enter": "rise"
            }
          ]
        }
      ],
      "hold": 4500.0
    },
    {
      "id": "growth",
      "mode": "absolute",
      "layout": "stat",
      "transition": "fast",
      "props": {
        "growth-number": {},
        "growth-meaning": {},
        "growth-aside": {}
      },
      "choreography": [
        {
          "sequence": [
            {
              "target": [
                "growth-number",
                "growth-meaning"
              ],
              "enter": "rise"
