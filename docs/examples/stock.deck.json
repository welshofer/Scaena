      "fetched": {
        "from": "twelve-data",
        "at": "2026-10-15T20:15:02Z",
        "asked": "ACME",
        "kept": true,
        "credit": [
          {
            "text": "Data provided by Twelve Data",
            "link": "https://twelvedata.com"
          }
