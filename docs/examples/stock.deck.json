        "stock": {
          "symbol": "ACME",
          "range": "3m",
          "exchange": "NASDAQ",
          "currency": "USD",
          "zone": "America/New_York",
          "through": "2026-10-15"
        }
      }
    }
  },
  "nodes": {
    "title": {
      "type": "text",
      "role": "headline",
      "semantic": "claim",
      "fit": "shrink",
      "at": {
        "in": "header"
      },
      "runs": [
        {
          "text": "ACME is "
        },
        {
          "text": "up",
          "quote": {
            "data": "@acme",
            "dataTransform": [
              {
                "aggregate": {
                  "last": "last(close)",
                  "base": "last(base)"
                }
              },
              {
                "derive": {
                  "change": "abs(last / base - 1)",
                  "way": "if(last >= base, 'up', 'down')"
                }
              }
            ],
            "column": "way"
          }
        },
        {
          "text": " "
        },
        {
          "text": "7.3%",
          "quote": {
            "data": "@acme",
            "dataTransform": [
              {
                "aggregate": {
                  "last": "last(close)",
                  "base": "last(base)"
                }
              },
              {
                "derive": {
                  "change": "abs(last / base - 1)",
                  "way": "if(last >= base, 'up', 'down')"
                }
              }
            ],
            "column": "change",
            "format": ".1%"
          }
        },
        {
          "text": " over three months"
        }
      ]
    },
    "prices": {
      "type": "chart",
      "kind": "line",
