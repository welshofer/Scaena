{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaena.dev/schema/theme-0.1.json",
  "title": "Scaena theme (design system)",
  "description": "Tokens, typographic roles, layout templates, motion, and palettes. Documents reference these by name; they never store resolved values. See docs/SPEC.md §3.6.",
  "type": "object",
  "required": ["scaena-theme", "name", "tokens", "type", "grid", "layouts", "motion"],
  "additionalProperties": false,
  "properties": {
    "scaena-theme": { "type": "string", "pattern": "^0\\.1(\\.[0-9]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tokens": {
      "type": "object", "required": ["color", "roles", "data", "space"], "additionalProperties": false,
      "properties": {
        "color": { "type": "object", "minProperties": 2, "additionalProperties": { "$ref": "#/$defs/ColorLiteral" } },
        "roles": {
          "type": "object", "required": ["surface", "onSurface", "accent", "onAccent"],
          "additionalProperties": { "type": "string", "description": "Name of a color token." }
        },
        "data": {
          "type": "object", "required": ["categorical"], "additionalProperties": false,
          "properties": {
            "categorical": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/ColorLiteral" } },
            "sequential": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/ColorLiteral" } },
            "diverging": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/ColorLiteral" } }
          }
        },
        "space": {
          "type": "object", "required": ["unit", "scale"], "additionalProperties": false,
          "properties": { "unit": { "type": "number", "exclusiveMinimum": 0 }, "scale": { "type": "array", "minItems": 4, "items": { "type": "number", "minimum": 0 } } }
        },
        "radius": { "type": "object", "additionalProperties": false, "properties": { "scale": { "type": "array", "items": { "type": "number", "minimum": 0 } } } },
        "stroke": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    },
    "type": {
      "type": "object", "required": ["families", "roles"], "additionalProperties": false,
      "properties": {
        "families": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "required": ["family", "file"], "additionalProperties": false,
            "properties": {
              "family": { "type": "string" },
              "file": { "type": "string", "pattern": "^fonts/" },
              "axes": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
              "fallback": { "type": "array", "items": { "type": "string" }, "description": "Other families in this theme, in order. Bundle-only; system fonts are never consulted." },
              "features": { "type": "object", "additionalProperties": { "type": ["boolean", "integer"] } }
            }
          }
        },
        "scale": { "type": "object", "additionalProperties": false, "properties": { "ratio": { "type": "number", "exclusiveMinimum": 1 }, "base": { "type": "number", "exclusiveMinimum": 0 } } },
        "roles": {
          "type": "object", "required": ["display", "headline", "body", "caption", "label", "numeral"],
          "additionalProperties": { "$ref": "#/$defs/Role" }
        }
      }
    },
    "grid": {
      "type": "object", "required": ["columns", "gutter", "margin"], "additionalProperties": false,
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1, "default": 6 },
        "gutter": { "type": "number", "minimum": 0 },
        "margin": { "oneOf": [ { "type": "number", "minimum": 0 }, { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 4 } ] },
        "baseline": { "type": "number", "exclusiveMinimum": 0, "description": "Baseline grid in cu; text leading snaps to multiples." }
      }
    },
    "layouts": {
      "type": "object", "required": ["title", "full"], "minProperties": 2,
      "additionalProperties": {
        "type": "object", "required": ["slots"], "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "formats": { "type": "object", "description": "Per-format overrides of slots (e.g. \"9:16\")." },
          "slots": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Slot" } }
        }
      }
    },
    "motion": {
      "type": "object", "required": ["durations", "easings", "springs", "presets"], "additionalProperties": false,
      "properties": {
        "durations": { "type": "object", "required": ["fast", "standard", "slow"], "additionalProperties": { "type": "number", "minimum": 0 } },
        "easings": { "type": "object", "required": ["standard", "in", "out"], "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } },
        "springs": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "object", "required": ["stiffness", "damping"], "additionalProperties": false,
          "properties": { "stiffness": { "type": "number", "exclusiveMinimum": 0 }, "damping": { "type": "number", "minimum": 0 }, "mass": { "type": "number", "exclusiveMinimum": 0 } } } },
        "presets": { "type": "object", "required": ["fade", "rise", "grow"], "additionalProperties": { "$ref": "#/$defs/Preset" } },
        "maxConcurrent": { "type": "integer", "minimum": 1, "default": 12 },
        "maxBuild": { "type": "number", "minimum": 0, "default": 2500, "description": "Max total choreography per state, ms (lint W321)." }
      }
    },
    "shaders": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "palettes": { "type": "object", "additionalProperties": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/ColorLiteral" } } },
        "presets": { "type": "object", "additionalProperties": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["mesh", "gradient", "noise", "grain", "particles"] }, "params": { "type": "object" }, "palette": { "type": "string" } } } }
      }
    },
    "charts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "axis": { "type": "object", "properties": { "role": { "type": "string" }, "stroke": { "type": "string" }, "color": { "type": "string" } } },
        "gridlines": { "type": "object", "properties": { "stroke": { "type": "string" }, "color": { "type": "string" }, "opacity": { "type": "number" } } },
        "label": { "type": "object", "properties": { "role": { "type": "string" } } },
        "strokeWidth": { "type": "string" },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "barGap": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "density": { "type": "object", "additionalProperties": false, "properties": { "maxWordsPerState": { "type": "integer", "minimum": 1, "default": 40 } } }
  },

  "$defs": {
    "ColorLiteral": { "type": "string", "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|oklch\\(.*\\)|oklab\\(.*\\))$" },
    "Role": {
      "type": "object", "required": ["family", "size", "weight", "leading"], "additionalProperties": false,
      "properties": {
        "family": { "type": "string", "description": "Key in type.families." },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "leading": { "type": "number", "exclusiveMinimum": 0, "description": "Line height as a multiple of size." },
        "tracking": { "type": "number", "description": "Em units; negative tightens." },
        "opsz": { "type": "number" },
        "axes": { "type": "object", "additionalProperties": { "type": "number" } },
        "features": { "type": "object", "additionalProperties": { "type": ["boolean", "integer"] } },
        "wrap": { "enum": ["greedy", "pretty", "balance"] },
        "box": { "enum": ["cap", "line"] },
        "measure": { "type": "number", "exclusiveMinimum": 0, "description": "Max characters per line." },
        "maxLines": { "type": "integer", "minimum": 1 },
        "minSize": { "type": "number", "exclusiveMinimum": 0 },
        "maxSize": { "type": "number", "exclusiveMinimum": 0 },
        "case": { "enum": ["none", "upper", "lower", "title", "smallcaps"] },
        "numeric": { "enum": ["tabular-lining", "tabular-oldstyle", "proportional-lining", "proportional-oldstyle"] },
        "minLastLineWords": { "type": "integer", "minimum": 1 },
        "opticalMargins": { "type": "boolean" },
        "hangingPunctuation": { "type": "boolean" },
        "hyphenate": { "type": "boolean" },
        "color": { "type": "string", "description": "Color role or token; defaults to onSurface." }
      }
    },
    "Slot": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "col": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 } ] },
        "row": { "oneOf": [ { "type": "integer", "minimum": 1 }, { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 } ] },
        "align": { "type": ["string", "object"] },
        "role": { "type": "string", "description": "Default text role for nodes placed in this slot." },
        "inset": { "type": "number" }
      }
    },
    "Preset": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "from": { "type": "object", "description": "Property values at the start (enter) or end (exit)." },
        "to": { "type": "object" },
        "duration": { "oneOf": [ { "type": "number", "minimum": 0 }, { "type": "string" } ] },
        "ease": { "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } ] },
        "spring": { "type": "string" },
        "stagger": { "type": "number", "minimum": 0 },
        "split": { "enum": ["lines", "words", "glyphs", "children", "marks"] },
        "description": { "type": "string" }
      }
    }
  }
}
