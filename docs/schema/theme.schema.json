{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaena.dev/schema/theme-0.1.json",
  "title": "Scaena theme (design system)",
  "description": "Tokens, typographic roles, layout templates, motion, and palettes. Documents reference these by name; they never store resolved values. See docs/SPEC.md §3.6.",
  "type": "object",
  "required": ["scaena-theme", "name", "tokens", "type", "grid", "layouts", "motion"],
  "additionalProperties": false,
  "properties": {
    "scaena-theme": { "description": "Theme format version.", "type": "string", "pattern": "^0\\.1(\\.[0-9]+)?$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tokens": { "$ref": "#/$defs/Tokens" },
    "type": { "$ref": "#/$defs/Typography" },
    "grid": { "$ref": "#/$defs/Grid" },
    "layouts": {
      "type": "object",
      "minProperties": 2,
      "required": ["title", "full"],
      "additionalProperties": { "$ref": "#/$defs/Layout" }
    },
    "motion": { "$ref": "#/$defs/Motion" },
    "shaders": { "$ref": "#/$defs/Shaders" },
    "charts": { "$ref": "#/$defs/Charts" },
    "density": { "$ref": "#/$defs/Density" }
  },
  "$defs": {
    "Tokens": {
      "type": "object",
      "required": ["color", "roles", "data", "space"],
      "additionalProperties": false,
      "properties": {
        "color": { "type": "object", "minProperties": 2, "additionalProperties": { "$ref": "#/$defs/ColorLiteral" } },
        "roles": {
          "description": "Color roles, each the name of a color token.",
          "type": "object",
          "required": ["surface", "onSurface", "accent", "onAccent"],
          "additionalProperties": { "type": "string" }
        },
        "data": { "$ref": "#/$defs/DataPalettes" },
        "space": { "$ref": "#/$defs/Space" },
        "radius": { "$ref": "#/$defs/Radius" },
        "stroke": { "type": "object", "additionalProperties": { "$ref": "#/$defs/NonNegative" } }
      }
    },
    "ColorLiteral": {
      "description": "`#rrggbb[aa]`, `oklch(...)`, or `oklab(...)`.",
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?|oklch\\(.*\\)|oklab\\(.*\\))$"
    },
    "DataPalettes": {
      "type": "object",
      "required": ["categorical"],
      "additionalProperties": false,
      "properties": {
        "categorical": { "type": "array", "items": { "$ref": "#/$defs/ColorLiteral" }, "minItems": 3 },
        "sequential": { "type": "array", "items": { "$ref": "#/$defs/ColorLiteral" }, "minItems": 2 },
        "diverging": { "type": "array", "items": { "$ref": "#/$defs/ColorLiteral" }, "minItems": 3 }
      }
    },
    "Space": {
      "type": "object",
      "required": ["unit", "scale"],
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "array", "items": { "$ref": "#/$defs/NonNegative" }, "minItems": 4 }
      }
    },
    "NonNegative": { "description": "A number at or above 0.", "type": "number", "minimum": 0 },
    "Radius": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "scale": { "type": "array", "items": { "$ref": "#/$defs/NonNegative" } } }
    },
    "Typography": {
      "type": "object",
      "required": ["families", "roles"],
      "additionalProperties": false,
      "properties": {
        "families": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Family" } },
        "scale": { "$ref": "#/$defs/TypeScale" },
        "roles": {
          "type": "object",
          "required": ["display", "headline", "body", "caption", "label", "numeral"],
          "additionalProperties": { "$ref": "#/$defs/Role" }
        }
      }
    },
    "Family": {
      "description": "A font family: its file in the bundle and how it may vary.",
      "type": "object",
      "required": ["family", "file"],
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string" },
        "file": { "type": "string", "pattern": "^fonts/" },
        "axes": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        },
        "fallback": {
          "description": "Other families in this theme, in order. Bundle-only; system fonts are never consulted.",
          "type": "array",
          "items": { "type": "string" }
        },
        "features": { "type": "object", "additionalProperties": { "$ref": "#/$defs/FeatureValue" } }
      }
    },
    "FeatureValue": { "anyOf": [{ "type": "boolean" }, { "type": "integer" }] },
    "TypeScale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ratio": { "type": "number", "exclusiveMinimum": 1 },
        "base": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "Role": {
      "description": "What a text role looks like (SPEC §3.5).",
      "type": "object",
      "required": ["family", "size", "weight", "leading"],
      "additionalProperties": false,
      "properties": {
        "family": { "description": "Key in `type.families`.", "type": "string" },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "leading": { "description": "Line height as a multiple of size.", "type": "number", "exclusiveMinimum": 0 },
        "tracking": { "description": "Em units; negative tightens.", "type": "number" },
        "opsz": { "type": "number" },
        "axes": { "type": "object", "additionalProperties": { "type": "number" } },
        "features": { "type": "object", "additionalProperties": { "$ref": "#/$defs/FeatureValue" } },
        "wrap": { "$ref": "#/$defs/Wrap" },
        "box": { "$ref": "#/$defs/TextBox" },
        "measure": { "description": "Max characters per line.", "type": "number", "exclusiveMinimum": 0 },
        "maxLines": { "type": "integer", "minimum": 1 },
        "minSize": { "type": "number", "exclusiveMinimum": 0 },
        "maxSize": { "type": "number", "exclusiveMinimum": 0 },
        "case": { "$ref": "#/$defs/Case" },
        "numeric": { "$ref": "#/$defs/Numeric" },
        "minLastLineWords": { "type": "integer", "minimum": 1 },
        "opticalMargins": { "type": "boolean" },
        "hangingPunctuation": { "type": "boolean" },
        "hyphenate": { "type": "boolean" },
        "color": { "description": "Color role or token; defaults to onSurface.", "type": "string" }
      }
    },
    "Wrap": { "type": "string", "enum": ["greedy", "pretty", "balance"] },
    "TextBox": { "type": "string", "enum": ["cap", "line"] },
    "Case": { "type": "string", "enum": ["none", "upper", "lower", "title", "smallcaps"] },
    "Numeric": {
      "type": "string",
      "enum": ["tabular-lining", "tabular-oldstyle", "proportional-lining", "proportional-oldstyle"]
    },
    "Grid": {
      "type": "object",
      "required": ["columns", "gutter", "margin"],
      "additionalProperties": false,
      "properties": {
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1, "default": 6 },
        "gutter": { "type": "number", "minimum": 0 },
        "margin": { "$ref": "#/$defs/Margin" },
        "baseline": {
          "description": "Baseline grid in cu; text leading snaps to multiples.",
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "Margin": {
      "description": "One margin for every side, or 2–4 CSS-style.",
      "anyOf": [
        { "type": "number", "minimum": 0 },
        { "type": "array", "items": { "$ref": "#/$defs/NonNegative" }, "minItems": 2, "maxItems": 4 }
      ]
    },
    "Layout": {
      "description": "A layout template: named slots on the grid.",
      "type": "object",
      "required": ["slots"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "formats": {
          "description": "Per-format overrides of slots (e.g. \"9:16\").",
          "type": "object",
          "additionalProperties": true
        },
        "slots": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Slot" } }
      }
    },
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "col": { "$ref": "#/$defs/Range" },
        "row": { "$ref": "#/$defs/Range" },
        "align": { "$ref": "#/$defs/Align" },
        "role": { "description": "Default text role for nodes placed in this slot.", "type": "string" },
        "inset": { "type": "number" }
      }
    },
    "Range": {
      "description": "A grid index or an inclusive [start, end] range (1-based).",
      "anyOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 2, "maxItems": 2 }
      ]
    },
    "Align": {
      "description": "Alignment within a slot or cell. Vertical anchors include typographic ones (SPEC §3.4).",
      "anyOf": [{ "$ref": "#/$defs/AlignX" }, { "$ref": "#/$defs/AlignAxes" }]
    },
    "AlignX": { "type": "string", "enum": ["start", "center", "end", "stretch"] },
    "AlignAxes": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "x": { "$ref": "#/$defs/AlignX" }, "y": { "$ref": "#/$defs/AlignY" } }
    },
    "AlignY": { "type": "string", "enum": ["start", "center", "end", "stretch", "cap", "baseline", "x-height"] },
    "Motion": {
      "type": "object",
      "required": ["durations", "easings", "springs", "presets"],
      "additionalProperties": false,
      "properties": {
        "durations": {
          "type": "object",
          "required": ["fast", "standard", "slow"],
          "additionalProperties": { "$ref": "#/$defs/NonNegative" }
        },
        "easings": {
          "type": "object",
          "required": ["standard", "in", "out"],
          "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        },
        "springs": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/SpringParams" } },
        "presets": {
          "type": "object",
          "required": ["fade", "rise", "grow"],
          "additionalProperties": { "$ref": "#/$defs/Preset" }
        },
        "maxConcurrent": { "type": "integer", "minimum": 1, "default": 12 },
        "maxBuild": {
          "description": "Max total choreography per state, ms (lint W321).",
          "type": "number",
          "minimum": 0,
          "default": 2500
        }
      }
    },
    "SpringParams": {
      "type": "object",
      "required": ["stiffness", "damping"],
      "additionalProperties": false,
      "properties": {
        "stiffness": { "type": "number", "exclusiveMinimum": 0 },
        "damping": { "type": "number", "minimum": 0 },
        "mass": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      }
    },
    "Preset": {
      "description": "A named entrance, exit, or emphasis: keyframes with parameters.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "Property values at the start (enter) or end (exit).",
          "type": "object",
          "additionalProperties": true
        },
        "to": { "type": "object", "additionalProperties": true },
        "duration": { "$ref": "#/$defs/Duration" },
        "ease": { "$ref": "#/$defs/Easing" },
        "spring": { "type": "string" },
        "stagger": { "$ref": "#/$defs/NonNegative" },
        "split": { "$ref": "#/$defs/SplitUnit" },
        "description": { "type": "string" }
      }
    },
    "Duration": {
      "description": "Milliseconds, or a named theme duration (\"fast\", \"standard\", \"slow\").",
      "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "string", "minLength": 1 }]
    },
    "Easing": {
      "description": "Named theme easing or a cubic Bézier [x1, y1, x2, y2].",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
      ]
    },
    "SplitUnit": {
      "description": "What a choreographed entrance splits its target into.",
      "type": "string",
      "enum": ["lines", "words", "glyphs", "children", "marks"]
    },
    "Shaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palettes": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/ColorLiteral" }, "minItems": 2 }
        },
        "presets": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ShaderPreset" } }
      }
    },
    "ShaderPreset": {
      "description": "A shader a node can name (PLAN 1.10).",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/ShaderKind" },
        "params": { "type": "object", "additionalProperties": true },
        "palette": { "type": "string" }
      }
    },
    "ShaderKind": { "type": "string", "enum": ["mesh", "gradient", "noise", "grain", "particles"] },
    "Charts": {
      "description": "Chart styling: every chart draws with these, never with literals.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis": { "$ref": "#/$defs/ChartRule" },
        "gridlines": { "$ref": "#/$defs/ChartRule" },
        "label": { "$ref": "#/$defs/ChartLabel" },
        "title": { "description": "Axis titles; their role defaults to the axis's.", "$ref": "#/$defs/ChartLabel" },
        "tickCount": {
          "description": "About how many ticks a value axis shows (d3's tick count); 5 when unset.",
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "strokeWidth": { "type": "string" },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "barGap": { "type": "number", "minimum": 0, "maximum": 1 },
        "groupGap": {
          "description": "Between the bars of one category's group, a fraction of each bar's slot; 0.1 when unset.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pointRadius": {
          "description": "A dot on each point of a line; none when unset.",
          "type": "number",
          "minimum": 0
        },
        "dotRadius": {
          "description": "A dot plot's dots, and a scatter's at its largest size; 8 when unset.",
          "type": "number",
          "minimum": 0
        },
        "donutHole": {
          "description": "A donut's hole, a fraction of its radius; 0.6 when unset.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "legend": { "description": "Legend labels; their role defaults to the axis's.", "$ref": "#/$defs/ChartLabel" }
      }
    },
    "ChartRule": {
      "description": "A chart rule: the axis or the gridlines.",
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "stroke": { "type": "string" },
        "color": { "type": "string" },
        "opacity": { "type": "number" }
      }
    },
    "ChartLabel": { "type": "object", "properties": { "role": { "type": "string" } } },
    "Density": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "maxWordsPerState": { "type": "integer", "minimum": 1, "default": 40 } }
    }
  }
}
