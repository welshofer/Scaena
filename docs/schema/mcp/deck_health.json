{
  "name": "deck_health",
  "description": "The deck's narrative health (PLAN G.9): Vzestup's measures of a talk, over its slides as its spine tells them, each 0–100 with what it says: pacing against the length its brief asked, the points each slide makes and what its notes give the speaker, how each slide follows from the one before (by their words, and so unscored), how the intensity each declares follows the curve of the arc it was written to, and whether its words carry the intensity and the tone it declares. Each slide as read: where its arc's curve stands, what it declares, and what its words read. Findings slide by slide, each with what to ask about it and, where one is safe, a patch for `deck_patch`: a moved slide made part of the beat it now stands in. A slide on which lint finds an error comes first. Words far from the intensity or the tone a slide declares are the words' to change, not the plan's.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": {
        "description": "The bundle's path: a directory, a `.scaena` zip, or a `deck.json`.",
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Measure": {
        "type": "object",
        "properties": { "score": { "type": ["integer", "null"], "minimum": 0 }, "says": { "type": "string" } },
        "required": ["says"]
      },
      "Read": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "beat": { "type": ["string", "null"] },
          "part": { "type": ["integer", "null"], "minimum": 0 },
          "title": { "type": "string" },
          "curve": { "type": "number" },
          "declared": { "type": ["number", "null"] },
          "read": { "type": ["number", "null"] },
          "tone": { "type": ["number", "null"] },
          "toneRead": { "type": ["number", "null"] },
          "after": { "type": ["number", "null"] },
          "standing": { "$ref": "#/$defs/Standing" },
          "sources": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["state", "title", "curve", "standing", "sources"]
      },
      "Standing": {
        "oneOf": [
          { "type": "string", "enum": ["ok"] },
          { "type": "string", "const": "bends" },
          { "type": "string", "const": "drifted" }
        ]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "slide": { "type": "integer", "minimum": 0 },
          "severity": { "$ref": "#/$defs/Severity" },
          "kind": { "$ref": "#/$defs/Kind" },
          "says": { "type": "string" },
          "ask": { "type": "string" },
          "fix": { "anyOf": [{ "$ref": "#/$defs/Fix" }, { "type": "null" }] },
          "figure": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "field": { "anyOf": [{ "$ref": "#/$defs/Field" }, { "type": "null" }] },
          "into": { "type": ["string", "null"] }
        },
        "required": ["state", "slide", "severity", "kind", "says", "ask"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Kind": {
        "oneOf": [
          { "type": "string", "const": "title" },
          { "type": "string", "const": "empty" },
          { "type": "string", "const": "turn" },
          { "type": "string", "const": "arc" },
          { "type": "string", "const": "intensity" },
          { "type": "string", "const": "tone" },
          { "type": "string", "const": "drift" },
          { "type": "string", "const": "layout" },
          { "type": "string", "const": "claim" },
          { "type": "string", "const": "bigIdea" },
          { "type": "string", "const": "story" },
          { "type": "string", "const": "dense" },
          { "type": "string", "const": "notes" },
          { "type": "string", "const": "pacing" },
          { "type": "string", "const": "link" },
          { "type": "string", "const": "look" },
          { "type": "string", "const": "source" },
          { "type": "string", "const": "thin" },
          { "type": "string", "const": "label" }
        ]
      },
      "Fix": {
        "type": "object",
        "properties": { "says": { "type": "string" }, "patch": { "type": "array", "items": true } },
        "required": ["says", "patch"]
      },
      "Field": {
        "oneOf": [
          { "type": "string", "const": "headline" },
          { "type": "string", "const": "notes" },
          { "type": "string", "const": "intensity" },
          { "type": "string", "const": "claim" }
        ]
      },
      "Capped": {
        "type": "object",
        "properties": {
          "slides": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "cap": { "type": "integer", "minimum": 0 },
          "score": { "type": "integer", "minimum": 0 }
        },
        "required": ["slides", "cap", "score"]
      },
      "Ask": {
        "type": "object",
        "properties": { "label": { "type": "string" }, "question": { "type": "string" } },
        "required": ["label", "question"]
      }
    },
    "required": [
      "score",
      "beats",
      "pacing",
      "balance",
      "coherence",
      "fidelity",
      "intensity",
      "tone",
      "slides",
      "findings"
    ],
    "type": "object",
    "properties": {
      "score": { "type": "integer", "minimum": 0 },
      "arc": { "type": ["string", "null"] },
      "beats": { "type": "array", "items": { "type": "string" } },
      "pacing": { "$ref": "#/$defs/Measure" },
      "balance": { "$ref": "#/$defs/Measure" },
      "coherence": { "$ref": "#/$defs/Measure" },
      "fidelity": { "$ref": "#/$defs/Measure" },
      "intensity": { "$ref": "#/$defs/Measure" },
      "tone": { "$ref": "#/$defs/Measure" },
      "slides": { "type": "array", "items": { "$ref": "#/$defs/Read" } },
      "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "bigIdea": { "type": ["string", "null"] },
      "capped": { "anyOf": [{ "$ref": "#/$defs/Capped" }, { "type": "null" }] },
      "compare": { "anyOf": [{ "$ref": "#/$defs/Ask" }, { "type": "null" }] }
    }
  }
}
