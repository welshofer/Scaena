{
  "name": "deck_inspect",
  "description": "Each state as it resolves (SPEC §2.2): its nodes with their props, what enters and exits. `resolved` adds each text node's look through the theme, `timeline` each motion as placed on the state's clock, `data` the rows each chart and table reads. With `state`: `layouts` the layouts the state may take, best first, each with the `set_state` that gives it; `state_choices` what an inspector offers for the state itself (its layout, transition, hold, notes, and slide number and footer); `choices` (a node) what the theme offers for each of its properties and where each lives, which `choose` writes; `inserts` what may be inserted, each as `add_node` adds it; `layers` the nodes as the editor's layers list them; `boxes` where each node stands and `at` what draws at a point; `targets` (a node) where it may go, with `snap` and `to` the `place` that puts it there; `look` (a node) its look and, with `onto`, the patch that pastes it on others; `arrange` (nodes) with `align`, `spread`, `order`, `before`, `after`, `into`, or `by` the patch that arranges them.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "SnapMode": {
        "description": "How a box dropped on a node's targets snaps (ADR-0013).",
        "oneOf": [
          {
            "description": "As many cells as the node spans, from the track nearest the box's corner.",
            "type": "string",
            "const": "move"
          },
          { "description": "Each edge to the nearest track's.", "type": "string", "const": "resize" },
          {
            "description": "Into the slot, or the grid container's area, the box covers most.",
            "type": "string",
            "const": "slot"
          },
          {
            "description": "Where it was dropped, in whole canvas units: a `rect`. On the theme's grid, an\noverride (W301); in a frame, its own way of placing.",
            "type": "string",
            "const": "free"
          },
          {
            "description": "Among a stack's children, where the box's middle falls.",
            "type": "string",
            "const": "order"
          }
        ]
      },
      "Align": {
        "description": "The edge, or the middle, that nodes aligned share.",
        "type": "string",
        "enum": ["left", "center", "right", "top", "middle", "bottom"]
      },
      "Spread": { "description": "The way nodes spread run.", "type": "string", "enum": ["across", "down"] },
      "Order": {
        "description": "Where a node goes among what its container paints.",
        "oneOf": [
          { "description": "In front of the next it overlaps.", "type": "string", "const": "forward" },
          { "description": "Behind the one before it that it overlaps.", "type": "string", "const": "backward" },
          { "description": "In front of all of them.", "type": "string", "const": "front" },
          { "description": "Behind all of them.", "type": "string", "const": "back" }
        ]
      }
    },
    "required": ["bundle"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "state": { "description": "One state; every state without it.", "type": ["string", "null"], "default": null },
      "resolved": {
        "description": "Through the theme cascade: each node with the deck's overrides merged in, each text\nnode's look, and what each node's overrides set.",
        "type": "boolean",
        "default": false
      },
      "timeline": {
        "description": "Its cue: where it falls on the deck's timeline, its transition, and each motion as\nplaced on its clock.",
        "type": "boolean",
        "default": false
      },
      "data": {
        "description": "The rows each chart and table reads, after its `dataTransform`.",
        "type": "boolean",
        "default": false
      },
      "boxes": {
        "description": "Each visible node's box at rest, canvas units: what a pointer selects and moves\n(ADR-0013).",
        "type": "boolean",
        "default": false
      },
      "at": {
        "description": "The nodes that draw at this point at rest, `[x, y]` in canvas units, topmost first,\neach with the containers it sits in (ADR-0013).",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2,
        "default": null
      },
      "format": {
        "description": "One of the deck's `formats` (`9:16`) to inspect it in, laid out again with its\ntemplate set; the deck's own canvas without it.",
        "type": ["string", "null"],
        "default": null
      },
      "targets": {
        "description": "A node shown in the state inspected: where it may go, as a drag snaps it (ADR-0013).\nWhat holds it, its cell, and the tracks, slots, or order it takes.",
        "type": ["string", "null"],
        "default": null
      },
      "snap": {
        "description": "With `targets` and `to`: how the dropped box snaps, and the patch that puts the node\nthere.",
        "anyOf": [{ "$ref": "#/$defs/SnapMode" }, { "type": "null" }],
        "default": null
      },
      "to": {
        "description": "With `snap`: the box a drag left, `[x, y, width, height]` in canvas units: the node's\ncell, moved or resized.",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 4,
        "maxItems": 4,
        "default": null
      },
      "fork": {
        "description": "With `snap` or `arrange`: the patch keeps what it changes to the state inspected,\nwritten into its own props wherever it lives now (`place`'s and `choose`'s `fork`).",
        "type": "boolean",
        "default": false
      },
      "arrange": {
        "description": "Several nodes shown in the state inspected, children of one container, arranged at\nonce (PLAN 2.42): with one of `align`, `spread`, `order`, or `by`, where each lands\nand the patch that puts them there.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "default": null
      },
      "align": {
        "description": "With `arrange`: the edge, or the middle, they all take: the one all of them reach\nfarthest, or the middle of them all; on a grid, snapped to its tracks.",
        "anyOf": [{ "$ref": "#/$defs/Align" }, { "type": "null" }],
        "default": null
      },
      "spread": {
        "description": "With `arrange`: the first and the last stay, and the ones between move so the gaps\nbetween them all are equal, `across` or `down`.",
        "anyOf": [{ "$ref": "#/$defs/Spread" }, { "type": "null" }],
        "default": null
      },
      "order": {
        "description": "With `arrange`: each goes `forward` in front of the next of its container's children\nthat it overlaps, `backward` behind the one before, or to the `front` or the `back` of\nthem all, by its `z`.",
        "anyOf": [{ "$ref": "#/$defs/Order" }, { "type": "null" }],
        "default": null
      },
      "before": {
        "description": "With `arrange`, one node: listed just before this other node, as `layers` lists them\n(PLAN 2.50): painted just over it, by the `z` that does it, or, in a stack, laid out\njust before it. Held by another container, or by none, the node goes there with it,\nplaced as that container places what it holds.",
        "type": ["string", "null"],
        "default": null
      },
      "after": {
        "description": "With `arrange`, one node: listed just after this other node: painted just under it, or,\nin a stack, laid out just after it; into what holds it, as with `before`.",
        "type": ["string", "null"],
        "default": null
      },
      "into": {
        "description": "With `arrange`, one node: into this container, listed first among what it holds,\nplaced as it places what it holds (PLAN 2.50).",
        "type": ["string", "null"],
        "default": null
      },
      "by": {
        "description": "With `arrange`: moved together `[dx, dy]` canvas units: the first snapped as a drag of\nit snaps, the rest as far as it went, each its own way.",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2,
        "default": null
      },
      "free": {
        "description": "With `by`: off the grid, each to whole canvas units (a `rect`), as Shift drags.",
        "type": "boolean",
        "default": false
      },
      "choices": {
        "description": "A node shown in the state inspected: what an inspector offers for it (ADR-0013). Each\nproperty it edits, with the theme's names for it or what the schema allows, the value\nthe state shows, and where that value lives, which is where `choose` writes.",
        "type": ["string", "null"],
        "default": null
      },
      "state_choices": {
        "description": "What an inspector offers for the state inspected itself (PLAN 2.36): its layout (the\ntheme's layouts with a slot for each node placed in one), each key of its transition,\nits hold, and its notes, each with the value it has and where it lives, which is where\n`set_state` writes.",
        "type": "boolean",
        "default": false
      },
      "layouts": {
        "description": "The layouts the state inspected may take, best first (PLAN 2.92): each of the theme's\nlayouts that `state_choices` offers, with what lint finds in the state laid out in it,\nfewest errors, then fewest warnings, then the layout it takes now, then those whose places\nit leaves fewest empty (`empty`), then those that set fewest of its texts in another role\n(`recast`), then the theme's order, so a layout it fills, with as many items as the layout\nhas, comes before one it fills in part; the states its patch changes; and that patch, one\n`set_state`. Those that draw the state alike, in `format` or on the deck's canvas, are\none, which names the rest (`alike`).",
        "type": "boolean",
        "default": false
      },
      "inserts": {
        "description": "What may be inserted in the state inspected (PLAN 2.34): a text in each of the\ntheme's roles, each kind of shape, each image in the bundle, a chart and a table of\neach data source (PLAN 2.41), and each shader preset, each as `add_node` adds it, with\nthe box it takes at first.",
        "type": "boolean",
        "default": false
      },
      "layers": {
        "description": "The state inspected's layers (PLAN 2.50): its nodes nested as their containers and\ngroups hold them, topmost first, with those that leave in it and those another state\nof its slide shows, hidden, each where the nearest state that shows it places it.",
        "type": "boolean",
        "default": false
      },
      "look": {
        "description": "A node shown in the state inspected: its look (PLAN 2.58), each property of its type's\nlook with the value the state shows, as the editor's ⌥⌘C picks it up.",
        "type": ["string", "null"],
        "default": null
      },
      "onto": {
        "description": "With `look`: nodes shown in the state to put it on, and what that makes: a `choose` for\neach property of it a node shows otherwise, written where that node's own value lives\n(what `deck_patch` takes), and the nodes that look so already or take none of it, with\nwhy.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "default": null
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Inspected": {
        "type": "object",
        "properties": {
          "state_id": { "type": "string" },
          "slide_id": { "type": "string" },
          "layout": { "type": ["string", "null"] },
          "nodes": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": true } },
          "entered": { "type": "array", "items": { "type": "string" } },
          "exited": { "type": "array", "items": { "type": "string" } },
          "looks": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/TextLook" } },
          "overrides": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          },
          "timeline": { "anyOf": [{ "$ref": "#/$defs/Cue" }, { "type": "null" }] },
          "data": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/Rows" } },
          "boxes": { "type": ["object", "null"], "additionalProperties": { "$ref": "#/$defs/NodeBox" } },
          "hits": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Hit" } },
          "targets": { "anyOf": [{ "$ref": "#/$defs/Targets" }, { "type": "null" }] },
          "snapped": { "anyOf": [{ "$ref": "#/$defs/Snapped" }, { "type": "null" }] },
          "arranged": { "anyOf": [{ "$ref": "#/$defs/Arranged" }, { "type": "null" }] },
          "choices": { "anyOf": [{ "$ref": "#/$defs/Choices" }, { "type": "null" }] },
          "state_choices": { "anyOf": [{ "$ref": "#/$defs/StateChoices" }, { "type": "null" }] },
          "layouts": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Suggestion" } },
          "inserts": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Insert" } },
          "layers": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Layer" } },
          "look": { "anyOf": [{ "$ref": "#/$defs/Look" }, { "type": "null" }] },
          "put": { "anyOf": [{ "$ref": "#/$defs/Put" }, { "type": "null" }] }
        },
        "required": ["state_id", "slide_id", "nodes", "entered", "exited"]
      },
      "TextLook": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "family": { "type": "string" },
          "size": { "type": "number" },
          "weight": { "type": "number" },
          "leading": { "type": "number" },
          "tracking": { "type": "number" },
          "color": { "type": "string" },
          "hex": { "type": "string" }
        },
        "required": ["role", "family", "size", "weight", "leading", "tracking", "color", "hex"]
      },
      "Cue": {
        "type": "object",
        "properties": {
          "start": { "type": "number" },
          "span": { "type": "number" },
          "hold": { "type": "number" },
          "transition": { "$ref": "#/$defs/Transition" },
          "motions": { "type": "array", "items": { "$ref": "#/$defs/Motion" } }
        },
        "required": ["start", "span", "hold", "transition", "motions"]
      },
      "Transition": {
        "type": "object",
        "properties": {
          "duration": { "type": "number" },
          "curve": { "$ref": "#/$defs/Curve" },
          "match": { "type": "string" },
          "style": { "type": ["string", "null"] },
          "direction": { "type": ["string", "null"] }
        },
        "required": ["duration", "curve", "match"]
      },
      "Curve": {
        "anyOf": [
          {
            "type": "object",
            "properties": { "ease": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 } },
            "required": ["ease"]
          },
          { "type": "object", "properties": { "spring": { "$ref": "#/$defs/Spring" } }, "required": ["spring"] }
        ]
      },
      "Spring": {
        "type": "object",
        "properties": {
          "stiffness": { "type": "number" },
          "damping": { "type": "number" },
          "mass": { "type": "number" }
        },
        "required": ["stiffness", "damping", "mass"]
      },
      "Motion": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "motion": { "type": "string" },
          "split": { "anyOf": [{ "$ref": "#/$defs/SplitUnit" }, { "type": "null" }] },
          "units": { "type": "integer", "minimum": 0 },
          "start": { "type": "number" },
          "stagger": { "type": "number" },
          "duration": { "type": "number" },
          "end": { "type": "number" },
          "moving": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "delay": { "type": "number" },
          "written": { "type": ["string", "null"] },
          "preset": { "type": ["string", "null"] },
          "curve": { "$ref": "#/$defs/Curve" },
          "from": { "anyOf": [{ "$ref": "#/$defs/LookChange" }, { "type": "null" }] },
          "to": { "anyOf": [{ "$ref": "#/$defs/LookChange" }, { "type": "null" }] },
          "peak": { "anyOf": [{ "$ref": "#/$defs/LookChange" }, { "type": "null" }] },
          "tracks": { "anyOf": [{ "$ref": "#/$defs/Tracks" }, { "type": "null" }] }
        },
        "required": ["node", "motion", "units", "start", "stagger", "duration", "end", "moving", "delay", "curve"]
      },
      "SplitUnit": { "type": "string", "enum": ["lines", "words", "glyphs", "paragraphs", "children", "marks"] },
      "LookChange": {
        "type": "object",
        "properties": {
          "opacity": { "type": ["number", "null"] },
          "translate": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "scale": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "rotate": { "type": ["number", "null"] },
          "anchor": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "tint": { "anyOf": [{ "$ref": "#/$defs/Tint" }, { "type": "null" }] },
          "progress": { "type": ["number", "null"] }
        }
      },
      "Tint": {
        "type": "object",
        "properties": { "color": { "type": "string" }, "amount": { "type": "number" } },
        "required": ["color", "amount"]
      },
      "Tracks": {
        "type": "object",
        "properties": {
          "opacity": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Key" } },
          "translate": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Key2" } },
          "scale": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Key2" } },
          "rotate": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Key" } },
          "progress": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Key" } },
          "anchor": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
        }
      },
      "Key": {
        "type": "object",
        "properties": { "t": { "type": "number" }, "v": { "type": "number" }, "curve": { "$ref": "#/$defs/Curve" } },
        "required": ["t", "v", "curve"]
      },
      "Key2": {
        "type": "object",
        "properties": {
          "t": { "type": "number" },
          "v": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "curve": { "$ref": "#/$defs/Curve" }
        },
        "required": ["t", "v", "curve"]
      },
      "Rows": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "types": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array", "items": true } }
        },
        "required": ["source", "columns", "types", "rows"]
      },
      "NodeBox": {
        "type": "object",
        "properties": {
          "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "parent": { "type": ["string", "null"] },
          "draws": { "type": "boolean" },
          "transform": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 6, "maxItems": 6 }
        },
        "required": ["rect", "draws"]
      },
      "Hit": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "transform": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 6, "maxItems": 6 },
          "containers": { "type": "array", "items": { "type": "string" } },
          "offset": { "type": ["integer", "null"], "minimum": 0 }
        },
        "required": ["node", "rect", "containers"]
      },
      "Targets": {
        "type": "object",
        "properties": {
          "by": { "type": "string" },
          "parent": { "type": ["string", "null"] },
          "cell": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "columns": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "rows": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "slots": {
            "type": "object",
            "additionalProperties": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
          },
          "flow": { "type": "array", "items": { "type": "string" } },
          "within": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "snaps": { "type": "array", "items": { "$ref": "#/$defs/SnapMode" } }
        },
        "required": ["by", "cell", "columns", "rows", "slots", "flow", "within", "snaps"]
      },
      "SnapMode": {
        "oneOf": [
          { "type": "string", "const": "move" },
          { "type": "string", "const": "resize" },
          { "type": "string", "const": "slot" },
          { "type": "string", "const": "free" },
          { "type": "string", "const": "order" }
        ]
      },
      "Snapped": {
        "type": "object",
        "properties": {
          "cell": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "patch": { "type": "array", "items": true }
        },
        "required": ["cell", "patch"]
      },
      "Arranged": {
        "type": "object",
        "properties": {
          "landed": { "type": "array", "items": { "$ref": "#/$defs/Landed" } },
          "patch": { "type": "array", "items": true }
        },
        "required": ["landed", "patch"]
      },
      "Landed": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "cell": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        },
        "required": ["node", "cell"]
      },
      "Choices": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "type": { "$ref": "#/$defs/NodeType" },
          "state": { "type": "string" },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } }
        },
        "required": ["node", "type", "state", "fields"]
      },
      "NodeType": {
        "type": "string",
        "enum": ["text", "shape", "image", "chart", "table", "shader", "stack", "grid", "frame", "group"]
      },
      "Field": {
        "type": "object",
        "properties": {
          "prop": { "type": "string" },
          "takes": { "$ref": "#/$defs/Takes" },
          "value": {},
          "lives": { "anyOf": [{ "$ref": "#/$defs/Where" }, { "type": "null" }] },
          "literal": { "type": "boolean" },
          "theme": {}
        },
        "required": ["prop", "takes"]
      },
      "Takes": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "of": { "$ref": "#/$defs/Vocabulary" },
              "names": { "type": "array", "items": { "type": "string" } },
              "overrides": { "type": "boolean" },
              "kind": { "type": "string", "const": "name" }
            },
            "required": ["kind", "of", "names"]
          },
          {
            "type": "object",
            "properties": {
              "words": { "type": "array", "items": { "type": "string" } },
              "kind": { "type": "string", "const": "word" }
            },
            "required": ["kind", "words"]
          },
          {
            "type": "object",
            "properties": {
              "min": { "type": ["number", "null"] },
              "above": { "type": ["number", "null"] },
              "max": { "type": ["number", "null"] },
              "whole": { "type": "boolean" },
              "overrides": { "type": "boolean" },
              "kind": { "type": "string", "const": "number" }
            },
            "required": ["kind"]
          },
          { "type": "object", "properties": { "kind": { "type": "string", "const": "flag" } }, "required": ["kind"] },
          { "type": "object", "properties": { "kind": { "type": "string", "const": "text" } }, "required": ["kind"] },
          {
            "type": "object",
            "properties": {
              "names": { "type": "array", "items": { "type": "string" } },
              "kind": { "type": "string", "const": "fractions" }
            },
            "required": ["kind", "names"]
          },
          {
            "type": "object",
            "properties": {
              "first": { "type": "integer", "minimum": 0 },
              "last": { "type": "integer", "minimum": 0 },
              "kind": { "type": "string", "const": "lines" }
            },
            "required": ["kind", "first", "last"]
          }
        ]
      },
      "Vocabulary": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "text-role",
              "font-family",
              "layout",
              "motion-preset",
              "duration",
              "easing",
              "spring",
              "shader-preset",
              "shader-palette"
            ]
          },
          { "type": "string", "const": "color" },
          { "type": "string", "const": "data-palette" },
          { "type": "string", "const": "stroke" },
          { "type": "string", "const": "shadow" },
          { "type": "string", "const": "radius" },
          { "type": "string", "const": "space" }
        ]
      },
      "Where": {
        "oneOf": [
          { "type": "string", "const": "overrides" },
          {
            "type": "object",
            "properties": { "state": { "type": "string" } },
            "required": ["state"],
            "additionalProperties": false
          },
          { "type": "string", "const": "node" }
        ]
      },
      "StateChoices": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } },
          "furniture": { "$ref": "#/$defs/FurnitureChoice" },
          "plan": { "anyOf": [{ "$ref": "#/$defs/PlanChoice" }, { "type": "null" }] },
          "cites": { "anyOf": [{ "$ref": "#/$defs/CiteChoice" }, { "type": "null" }] }
        },
        "required": ["state", "fields", "furniture"]
      },
      "FurnitureChoice": {
        "type": "object",
        "properties": {
          "placed": { "type": "boolean" },
          "number": { "type": "boolean" },
          "footer": { "type": ["string", "null"] },
          "head": { "type": "string" },
          "slide": { "type": ["boolean", "null"] },
          "shown": { "type": "boolean" }
        },
        "required": ["placed", "number", "head", "shown"]
      },
      "PlanChoice": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "at": { "type": "string" },
          "intensity": { "type": ["number", "null"] },
          "tone": { "type": ["number", "null"] },
          "intensities": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "string" }],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "tones": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [{ "type": "number" }, { "type": "string" }],
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": ["beat", "at", "intensities", "tones"]
      },
      "CiteChoice": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "at": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["beat", "at", "evidence"]
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "layout": { "type": "string" },
          "current": { "type": "boolean" },
          "errors": { "type": "integer", "minimum": 0 },
          "warnings": { "type": "integer", "minimum": 0 },
          "empty": { "type": "integer", "minimum": 0 },
          "recast": { "type": "integer", "minimum": 0 },
          "alike": { "type": "array", "items": { "type": "string" } },
          "reach": { "type": "array", "items": { "type": "string" } },
          "patch": { "type": "array", "items": true }
        },
        "required": ["layout", "errors", "warnings", "empty", "recast", "reach", "patch"]
      },
      "Insert": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "node": {},
          "id": { "type": "string" },
          "start": { "$ref": "#/$defs/Start" },
          "sample": { "anyOf": [{ "$ref": "#/$defs/Sample" }, { "type": "null" }] }
        },
        "required": ["label", "node", "id", "start"]
      },
      "Start": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "box": {
                "type": "object",
                "properties": { "w": { "type": "number" }, "h": { "type": "number" } },
                "required": ["w", "h"]
              }
            },
            "required": ["box"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "slot": { "type": "string" } },
            "required": ["slot"],
            "additionalProperties": false
          }
        ]
      },
      "Sample": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "source": true },
        "required": ["name", "source"]
      },
      "Layer": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "type": { "$ref": "#/$defs/NodeType" },
          "shown": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "children": { "type": "array", "items": { "$ref": "#/$defs/Layer" } }
        },
        "required": ["node", "type", "shown"]
      },
      "Look": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "type": { "$ref": "#/$defs/NodeType" },
          "props": { "type": "array", "items": { "$ref": "#/$defs/Part" } }
        },
        "required": ["node", "type", "props"]
      },
      "Part": { "type": "object", "properties": { "prop": { "type": "string" }, "value": {} }, "required": ["prop"] },
      "Put": {
        "type": "object",
        "properties": {
          "patch": { "type": "array", "items": true },
          "took": { "type": "array", "items": { "type": "string" } },
          "same": { "type": "array", "items": { "type": "string" } },
          "refused": { "type": "array", "items": { "$ref": "#/$defs/Refused" } }
        },
        "required": ["patch", "took", "same", "refused"]
      },
      "Refused": {
        "type": "object",
        "properties": { "node": { "type": "string" }, "why": { "type": "string" } },
        "required": ["node", "why"]
      }
    },
    "type": "object",
    "properties": { "states": { "type": "array", "items": { "$ref": "#/$defs/Inspected" } } },
    "required": ["states"]
  }
}
