{
  "name": "deck_export",
  "description": "Export a projection to `out`: `pdf` (each slide at its last state, or `states`, a page each; with `notes`, the slide smaller with the presenter's notes under it), `png` or `svg` (an image per state, into a directory), `mp4`, `webm`, or `prores` (the timeline, each state's cue then its hold, or where it has none its share of its beat's `duration` (`pace`), at `fps`; needs ffmpeg), `html` (one file that plays the deck in a browser, offline: the player, the engine, and the bundle), or `spine`, which is also returned. An export that takes longer than 40 s keeps going: the call returns `running`, how far it has got, and the same call again waits for the rest, then returns what it wrote.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Painter": {
        "description": "Which painter draws the frame.",
        "oneOf": [
          { "description": "`vello_cpu`: every machine, the goldens' painter.", "type": "string", "const": "cpu" },
          {
            "description": "vello on the GPU, in a build with the `gpu` feature (PLAN 0.7).",
            "type": "string",
            "const": "gpu"
          }
        ]
      },
      "Pace": {
        "description": "How a projection paces the deck's global timeline (SPEC §2.4, §10).",
        "oneOf": [
          {
            "description": "Each state its `hold`; where it has none, its share of its beat's `duration`, less the\ncues of the beat's states ([`paced`]): a talk timed as it is given, though a player\nwaits on the presenter.",
            "type": "string",
            "const": "beats"
          },
          {
            "description": "Each state its `hold` alone, as a player auto-advances: a state with none comes to\nrest and goes on at once.",
            "type": "string",
            "const": "holds"
          }
        ]
      }
    },
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "format": {
        "description": "`spine`, `pdf`, `png`, `svg`, `mp4`, `webm`, `prores`, or `html`.",
        "type": "string"
      },
      "states": {
        "description": "The states a frame export draws, in this order: an image each (png, svg), a page\neach (pdf), each one's part of the timeline (video), or the states it plays (html).\nWithout it: every state; a PDF's slides, each at its last state, in spine order; a\nvideo's whole timeline.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "default": null
      },
      "out": {
        "description": "Where to write it: a file (pdf, video, html, spine), or a directory that gets an\nimage per state (png, svg), under the server's working directory or the bundle's\nfolder. Only the spine needs none.",
        "type": ["string", "null"],
        "default": null
      },
      "size": {
        "description": "`WxH` pixels for png, svg, and video, in the canvas's aspect ratio; the canvas's\nsize without it.",
        "type": ["string", "null"],
        "default": null
      },
      "fps": {
        "description": "A video's frames a second; 60 without it.",
        "type": ["integer", "null"],
        "minimum": 0,
        "default": null
      },
      "audio": {
        "description": "A video's sound track, a file ffmpeg reads under this server's folder or the bundle's,\nfrom the first frame: cut where the video ends, or carried on in silence until it does.",
        "type": ["string", "null"],
        "default": null
      },
      "painter": {
        "description": "What paints a video's frames: `gpu` is vello on the GPU, in a server built with the\n`gpu` feature. Every other export paints with the CPU painter.",
        "$ref": "#/$defs/Painter",
        "default": "cpu"
      },
      "pace": {
        "description": "How a video and the spine pace the timeline: `beats` (the default) gives each state\nwith no `hold` its share of its beat's `duration`, as the talk is given; `holds` plays\neach state's hold alone, as a player auto-advances.",
        "$ref": "#/$defs/Pace",
        "default": "beats"
      },
      "notes": {
        "description": "The presenter's notes: a PDF with each slide drawn smaller at the head of a page, the\nnotes a presenter reads for it under it, notes too long for it going on to pages of\ntheir own; a single HTML file with each state's and beat's notes, each beat's evidence,\nand what Narrato planned, the presenter's own copy. Without it a single file leaves them\nout, for the room. Only a PDF or a single file.",
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false,
    "required": ["bundle", "format"]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "SpineProjection": {
        "type": "object",
        "properties": {
          "scaena": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "lang": { "type": ["string", "null"] },
          "canvas": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "formats": { "type": "array", "items": { "type": "string" }, "default": [] },
          "spine": { "anyOf": [{ "$ref": "#/$defs/Spine" }, { "type": "null" }] },
          "pace": { "anyOf": [{ "$ref": "#/$defs/Pace" }, { "type": "null" }] },
          "states": { "type": "array", "items": { "$ref": "#/$defs/SpineState" } },
          "beats": { "type": "object", "additionalProperties": { "$ref": "#/$defs/SpineBeat" }, "default": {} }
        },
        "additionalProperties": false,
        "required": ["scaena", "canvas", "states"]
      },
      "Spine": {
        "type": "object",
        "properties": { "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } } },
        "additionalProperties": false,
        "required": ["sections"]
      },
      "Section": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/Id" },
          "title": { "type": ["string", "null"] },
          "beats": { "type": "array", "items": { "$ref": "#/$defs/Beat" }, "minItems": 1 }
        },
        "additionalProperties": false,
        "required": ["id", "beats"]
      },
      "Id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "Beat": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/Id" },
          "claim": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "states": { "$ref": "#/$defs/IdList" },
          "notes": { "type": ["string", "null"] },
          "duration": { "type": ["number", "null"], "minimum": 0 },
          "media": { "type": ["object", "null"], "additionalProperties": true }
        },
        "additionalProperties": false,
        "required": ["id", "claim"]
      },
      "IdList": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
      "Pace": { "oneOf": [{ "type": "string", "const": "beats" }, { "type": "string", "const": "holds" }] },
      "SpineState": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slide": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "hold": { "type": ["number", "null"] },
          "rest": { "type": ["number", "null"] },
          "start": { "type": ["number", "null"] },
          "span": { "type": ["number", "null"] }
        },
        "additionalProperties": false,
        "required": ["id", "slide"]
      },
      "SpineBeat": {
        "type": "object",
        "properties": {
          "section": { "type": "string" },
          "state": { "type": ["string", "null"] },
          "start": { "type": ["number", "null"] },
          "end": { "type": ["number", "null"] },
          "thumbnail": { "type": ["string", "null"] },
          "formats": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false,
        "required": ["section"]
      },
      "Played": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "start": { "type": "number" },
          "span": { "type": "number" },
          "hold": { "type": "number" }
        },
        "required": ["state", "start", "span", "hold"]
      },
      "Chapter": {
        "type": "object",
        "properties": {
          "beat": { "type": ["string", "null"] },
          "title": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" }
        },
        "required": ["title", "start", "end"]
      },
      "Running": {
        "type": "object",
        "properties": {
          "done": { "type": "integer", "minimum": 0 },
          "of": { "type": "integer", "minimum": 0 },
          "unit": { "type": "string" },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "next": { "type": "string" }
        },
        "required": ["done", "of", "unit", "elapsed_ms", "next"]
      }
    },
    "required": ["format"],
    "type": "object",
    "properties": {
      "format": { "type": "string" },
      "out": { "type": ["string", "null"] },
      "spine": { "anyOf": [{ "$ref": "#/$defs/SpineProjection" }, { "type": "null" }] },
      "pages": { "type": ["array", "null"], "items": { "type": "string" } },
      "files": { "type": ["array", "null"], "items": { "type": "string" } },
      "size": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
      "frames": { "type": ["integer", "null"], "minimum": 0 },
      "fps": { "type": ["integer", "null"], "minimum": 0 },
      "duration_ms": { "type": ["number", "null"] },
      "pace": { "type": ["string", "null"] },
      "timeline": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Played" } },
      "chapters": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Chapter" } },
      "painter": { "type": ["string", "null"] },
      "adapter": { "type": ["string", "null"] },
      "bytes": { "type": ["integer", "null"], "minimum": 0 },
      "running": { "anyOf": [{ "$ref": "#/$defs/Running" }, { "type": "null" }] }
    }
  }
}
