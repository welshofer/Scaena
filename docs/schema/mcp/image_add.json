{
  "name": "image_add",
  "description": "Put a picture the user hands you on a slide: a PNG or JPEG `file` (a logo, a product shot, a chart drawn elsewhere), copied into the bundle's `assets/` named by its content, one past 8192 px a side made smaller first. It goes in the image `into` names, in place of what it showed; else in the state's first empty place for a picture; else as a new image at `at` ([x, y, width, height], canvas units), kept to its slide. `alt` says what it shows for someone who cannot see it. One patch, refused as a patch is; `dry_run` writes nothing.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "file"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "file": { "description": "The picture: a PNG or a JPEG file.", "type": "string" },
      "state": {
        "description": "The state it goes in; the first, where none is named.",
        "type": ["string", "null"],
        "default": null
      },
      "into": {
        "description": "An image it goes in, which shows it in place of what it showed.",
        "type": ["string", "null"],
        "default": null
      },
      "at": {
        "description": "The box a new image takes, `[x, y, width, height]` in canvas units, where it goes in no\nimage and the slide has no empty place for a picture.",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 4,
        "maxItems": 4,
        "default": null
      },
      "alt": {
        "description": "What it shows, for someone who cannot see it: the image's description (`alt`).",
        "type": ["string", "null"],
        "default": null
      },
      "dry_run": {
        "description": "Say what it would put where, and write nothing.",
        "type": "boolean",
        "default": false
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      }
    },
    "required": ["node", "src", "said", "applied", "patch", "added", "removed", "errors", "states"],
    "type": "object",
    "properties": {
      "node": { "type": "string" },
      "src": { "type": "string" },
      "said": { "type": "string" },
      "applied": { "type": "boolean" },
      "patch": { "type": "array", "items": { "$ref": "#/$defs/JsonOp" } },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "states": { "type": "array", "items": { "type": "string" } },
      "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } }
    }
  }
}
