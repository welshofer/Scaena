{
  "name": "deck_history",
  "description": "A bundle's versions (SPEC §8): each change its history keeps, by author and time, oldest first, each named by its number as listed or by its id, and told as the editors tell it: what it did (`said`), by whom (`by`), and, for the last 25 versions, what it changed from the version before, slide by slide, each object by what it shows (`changed`). With `begin`, a history begun where the bundle keeps none, the deck as it is its first version. With `at`, the deck as it was just after one (`scn` for source); with `compare`, what changed from one version to another, or, with one, to the deck as it is now: each state added, removed, or changed (its own fields, and its nodes as `deck_diff` says them), the deck's own fields, and the files it is drawn from, data files and the theme, whose bytes changed, each with what it was before (`before`); with `restore`, that version made the deck again, with its data files and its theme as they were: one change, refused as a patch is where the deck would not validate in the bundle as it is (`dry_run` writes nothing). A version is named by its number, its id, or how far back from the latest it is: `restore: \"-1\"`, the version before the latest, undoes the last change. With `restore` and `slide`, a state, only the slide that holds it is put back as that version held it, its steps, the objects it alone shows, its data, and its beat, and every edit made since stays. With `last`, only the last that many versions are listed.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": {
        "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`. Its history is\n`history/deck.loro`, which `begin` here, `deck_create`, or `scaena save --history` begins.",
        "type": "string"
      },
      "at": {
        "description": "The deck as it was in this version: its number as listed (`3`), or its id.",
        "type": ["string", "null"],
        "default": null
      },
      "scn": { "description": "With `at`, the deck as `.scn` source (SPEC §4).", "type": "boolean", "default": false },
      "compare": {
        "description": "What changed from the first version to the second, or, with one, to the deck as it is\nnow, state by state.",
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "restore": {
        "description": "Make this version the deck again, with its data files and its theme as they were: one\nchange.",
        "type": ["string", "null"],
        "default": null
      },
      "slide": {
        "description": "With `restore`, the one slide that holds this state, put back as the version held it\ninto the deck as it is now, with everything else as it is: its steps, the objects it\nalone shows, the data it reads, and its beat (agent dogfood 7).",
        "type": ["string", "null"],
        "default": null
      },
      "dry_run": {
        "description": "With `restore`, say what it would change, and write nothing.",
        "type": "boolean",
        "default": false
      },
      "begin": {
        "description": "Begin a history where the bundle keeps none, and list its versions: its first holds the\ndeck as it is, and every write after is recorded. A bundle that keeps one lists it.",
        "type": "boolean",
        "default": false
      },
      "last": {
        "description": "Listing the versions, only the last this many, each by its number in the whole history.",
        "type": ["integer", "null"],
        "minimum": 0,
        "default": null
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Told": {
        "type": "object",
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "id": { "type": "string" },
          "author": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] },
          "at": { "type": ["string", "null"] },
          "ops": { "type": "integer", "minimum": 0 },
          "said": { "type": "string" },
          "by": { "type": "string" },
          "changed": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["n", "id", "ops", "said", "by", "changed"]
      },
      "Seen": {
        "type": "object",
        "properties": {
          "version": { "$ref": "#/$defs/Version" },
          "deck": {},
          "scn": { "type": ["string", "null"] },
          "files": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["version", "files"]
      },
      "Version": {
        "type": "object",
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "id": { "type": "string" },
          "author": { "type": ["string", "null"] },
          "message": { "type": ["string", "null"] },
          "at": { "type": ["string", "null"] },
          "ops": { "type": "integer", "minimum": 0 }
        },
        "required": ["n", "id", "ops"]
      },
      "Compared": {
        "type": "object",
        "properties": {
          "from": { "$ref": "#/$defs/Version" },
          "to": { "anyOf": [{ "$ref": "#/$defs/Version" }, { "type": "null" }] },
          "states": { "type": "object", "additionalProperties": { "$ref": "#/$defs/StateChange" } },
          "deck": { "type": "object", "additionalProperties": true },
          "before": { "type": "object", "additionalProperties": true },
          "files": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["from", "states", "deck", "before", "files"]
      },
      "StateChange": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "added": { "type": "boolean" } },
            "required": ["added"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "removed": { "type": "boolean" } },
            "required": ["removed"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "changed": { "$ref": "#/$defs/Changed" } },
            "required": ["changed"],
            "additionalProperties": false
          }
        ]
      },
      "Changed": {
        "type": "object",
        "properties": {
          "fields": { "type": "object", "additionalProperties": true },
          "nodes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Change" } },
          "before": { "$ref": "#/$defs/Before" }
        },
        "required": ["fields", "nodes", "before"]
      },
      "Change": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "enter": { "type": "object", "additionalProperties": true } },
            "required": ["enter"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "exit": { "type": "boolean" } },
            "required": ["exit"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": { "change": { "type": "object", "additionalProperties": true } },
            "required": ["change"],
            "additionalProperties": false
          }
        ]
      },
      "Before": {
        "type": "object",
        "properties": {
          "fields": { "type": "object", "additionalProperties": true },
          "nodes": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": true } }
        },
        "required": ["fields", "nodes"]
      },
      "Restored": {
        "type": "object",
        "properties": {
          "version": { "$ref": "#/$defs/Version" },
          "applied": { "type": "boolean" },
          "files": { "type": "array", "items": { "type": "string" } },
          "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "errors": { "type": "integer", "minimum": 0 },
          "states": { "type": "array", "items": { "type": "string" } },
          "slide": { "type": ["string", "null"] },
          "kept": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["version", "applied", "files", "added", "removed", "errors", "states"]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] }
    },
    "properties": {
      "versions": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Told" } },
      "begun": { "type": ["boolean", "null"] },
      "seen": { "anyOf": [{ "$ref": "#/$defs/Seen" }, { "type": "null" }] },
      "compared": { "anyOf": [{ "$ref": "#/$defs/Compared" }, { "type": "null" }] },
      "restored": { "anyOf": [{ "$ref": "#/$defs/Restored" }, { "type": "null" }] }
    },
    "type": "object"
  }
}
