{
  "name": "state_start",
  "description": "Start a slide after `state`'s slide, as Add Slide starts one (PLAN 3.30), in one of the theme's layouts: a new state, absolute, in the layout, with a text in each slot that says what goes there, in the slot's role, its words to type over (`replace_text` or `set_text` put yours), the headline the slide's claim and shrunk to fit, a shape in each slot that holds one, and the slots that wait for a picture or a figure left empty; it stays on its slide. One patch, all or none, refused as `deck_patch` refuses one, reported as `deck_patch` reports one with its JSON Patch, with `id`, the new state's (yours, given as `id`), `filled`, each slot and the node in it, and `empty`, each slot left for a picture or a figure and what goes there. `deck_inspect` with `layouts` lists the layouts a state may take.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "state"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "state": {
        "description": "The state the slide goes after: after the last step of its slide, in its beat.",
        "type": "string"
      },
      "layout": {
        "description": "One of the theme's layouts (`deck_inspect` with `layouts` lists what a state may take,\neach by its name; `deck_read` with `theme` gives them all, in its `layouts`). Without it, a blank slide.",
        "type": ["string", "null"],
        "default": null
      },
      "claim": {
        "description": "The one sentence the slide tells: its headline says it, and it starts a beat of its own for\nit, just after the beat of the state it follows. Without it, the slide joins that beat.",
        "type": ["string", "null"],
        "default": null
      },
      "id": {
        "description": "The new state's id, and its nodes' after it (`pricing-header`). Without it, the layout's\nname (`bullets`, `bullets-2`, …).",
        "type": ["string", "null"],
        "default": null
      },
      "dry_run": { "description": "Say what would change, and write nothing.", "type": "boolean", "default": false }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "SlotFilled": {
        "type": "object",
        "properties": { "slot": { "type": "string" }, "node": { "type": "string" } },
        "required": ["slot", "node"]
      },
      "SlotEmpty": {
        "type": "object",
        "properties": { "slot": { "type": "string" }, "waits": { "type": "string" } },
        "required": ["slot", "waits"]
      },
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      }
    },
    "required": ["id", "filled", "empty", "applied", "patch", "added", "removed", "errors", "states"],
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "filled": { "type": "array", "items": { "$ref": "#/$defs/SlotFilled" } },
      "empty": { "type": "array", "items": { "$ref": "#/$defs/SlotEmpty" } },
      "applied": { "type": "boolean" },
      "patch": { "type": "array", "items": { "$ref": "#/$defs/JsonOp" } },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "states": { "type": "array", "items": { "type": "string" } },
      "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } }
    }
  }
}
