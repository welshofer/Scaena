{
  "name": "map_fetch",
  "description": "Put a map on a slide (ADR-0030): a picture of `place` (an address, a place, or `lat, lon`) fetched once from Geoapify with the user's own key ($GEOAPIFY_API_KEY), kept in the bundle, and drawn with a pin, its label, and the credit Geoapify's terms ask. It sends the place's words to Geoapify's geocoder (api.geoapify.com) and the map's middle, size, and zoom to its static map (maps.geoapify.com), under Geoapify's terms; coordinates skip the geocoder. It goes in the image `into`, else the slide's first empty place for a picture, else a new image at `at`, in one patch by its author, refused as a patch is. A name that matches several places answers them in `places`: ask again with `pick`, from 1. `refresh`, an image's id, fetches its map again, the same place and view or at `zoom` or `center`, one patch, both pictures kept.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": {
        "description": "The bundle's path: a directory, a `.scaena` zip, or a `deck.json`.",
        "type": "string"
      },
      "place": {
        "description": "Where: an address, a place, or `lat, lon`. Not with `refresh`.",
        "type": ["string", "null"],
        "default": null
      },
      "refresh": {
        "description": "An image fetched before, fetched again: the same place and view, or `zoom` or `center`.",
        "type": ["string", "null"],
        "default": null
      },
      "state": {
        "description": "The state it goes in: the first, where none is named.",
        "type": ["string", "null"],
        "default": null
      },
      "into": {
        "description": "An image it goes in, in place of what it shows.",
        "type": ["string", "null"],
        "default": null
      },
      "at": {
        "description": "The box a new image takes, `[x, y, width, height]` in canvas units, where the slide has no\nempty place for a picture.",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 4,
        "maxItems": 4,
        "default": null
      },
      "show": {
        "description": "What the box spans across: `block` (about 500 m), `neighborhood` (2 km, the default),\n`city` (20 km), or `region` (200 km).",
        "type": ["string", "null"],
        "default": null
      },
      "zoom": {
        "description": "The service's zoom, 1 to 20, in place of `show`.",
        "type": ["number", "null"],
        "default": null
      },
      "label": {
        "description": "The pin's label: the place's name where none is given, none where it is empty.",
        "type": ["string", "null"],
        "default": null
      },
      "style": {
        "description": "`light` or `dark`, as the theme's surface asks where none is given, or `bright`.",
        "type": ["string", "null"],
        "default": null
      },
      "pick": {
        "description": "Which of several places the name matches, from 1, as `places` lists them.",
        "type": ["integer", "null"],
        "minimum": 0,
        "default": null
      },
      "places": {
        "description": "Only list the places the name matches, and write nothing.",
        "type": "boolean",
        "default": false
      },
      "center": {
        "description": "A refresh's middle, `[lat, lon]`, where it is not where the map was centered.",
        "type": ["array", "null"],
        "items": { "type": "number" },
        "minItems": 2,
        "maxItems": 2,
        "default": null
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Target": {
        "type": "object",
        "properties": {
          "state": { "type": "string" },
          "node": { "type": ["string", "null"] },
          "slot": { "type": ["string", "null"] },
          "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
          "style": { "type": "string" },
          "lang": { "type": ["string", "null"] }
        },
        "required": ["state", "rect", "style"]
      },
      "Placed": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "src": { "type": "string" },
          "place": { "type": "string" },
          "said": { "type": "string" },
          "applied": { "type": "boolean" },
          "patch": { "type": "array", "items": { "$ref": "#/$defs/JsonOp" } },
          "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "errors": { "type": "integer", "minimum": 0 },
          "states": { "type": "array", "items": { "type": "string" } },
          "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } }
        },
        "required": ["node", "src", "place", "said", "applied", "patch", "added", "removed", "errors", "states"]
      },
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      },
      "Found": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "lat": { "type": "number" },
          "lon": { "type": "number" },
          "kind": { "type": ["string", "null"] }
        },
        "required": ["name", "address", "lat", "lon"]
      }
    },
    "required": ["places"],
    "type": "object",
    "properties": {
      "target": { "anyOf": [{ "$ref": "#/$defs/Target" }, { "type": "null" }] },
      "placed": { "anyOf": [{ "$ref": "#/$defs/Placed" }, { "type": "null" }] },
      "places": { "type": "array", "items": { "$ref": "#/$defs/Found" } }
    }
  }
}
