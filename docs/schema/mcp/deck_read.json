{
  "name": "deck_read",
  "description": "The bundle's deck, as `deck.json` holds it, or as `.scn` source; with `files`, the bundle's images, fonts, and data too, and what uses each; with `theme`, the theme it draws in.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "scn": { "description": "The deck as `.scn` source rather than JSON.", "type": "boolean", "default": false },
      "files": {
        "description": "The bundle's images, fonts, and data too, each with what in the deck names it and the\nnodes drawn from it in the states that show them so; a file nothing names has no\n`named`, and may be taken out (`scaena files --remove`).",
        "type": "boolean",
        "default": false
      },
      "theme": {
        "description": "The theme the deck draws in too, as the bundle holds it: its colors, type roles, layouts\nand their slots, and presets, by the names the deck uses (SPEC §3.6).",
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "BundleFile": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "type": { "$ref": "#/$defs/Kind" },
          "bytes": { "type": "integer", "minimum": 0 },
          "named": { "type": "array", "items": { "$ref": "#/$defs/Named" } },
          "used": { "type": "array", "items": { "$ref": "#/$defs/Used" } },
          "fetched": { "anyOf": [{ "$ref": "#/$defs/FetchedFrom" }, { "type": "null" }] }
        },
        "required": ["path", "type", "bytes", "named", "used"]
      },
      "Kind": { "type": "string", "enum": ["image", "font", "data"] },
      "Named": {
        "oneOf": [
          {
            "type": "object",
            "properties": { "node": { "type": "string" }, "by": { "type": "string", "const": "node" } },
            "required": ["by", "node"]
          },
          {
            "type": "object",
            "properties": { "beat": { "type": "string" }, "by": { "type": "string", "const": "evidence" } },
            "required": ["by", "beat"]
          },
          {
            "type": "object",
            "properties": {
              "family": { "type": "string" },
              "style": { "type": ["string", "null"] },
              "by": { "type": "string", "const": "font" }
            },
            "required": ["by", "family"]
          },
          {
            "type": "object",
            "properties": { "family": { "type": "string" }, "by": { "type": "string", "const": "theme" } },
            "required": ["by", "family"]
          },
          {
            "type": "object",
            "properties": { "source": { "type": "string" }, "by": { "type": "string", "const": "source" } },
            "required": ["by", "source"]
          }
        ]
      },
      "Used": {
        "type": "object",
        "properties": { "node": { "type": "string" }, "states": { "type": "array", "items": { "type": "string" } } },
        "required": ["node", "states"]
      },
      "FetchedFrom": {
        "type": "object",
        "properties": {
          "from": { "type": "string" },
          "service": { "type": "string" },
          "date": { "type": "string" },
          "said": { "type": "string" }
        },
        "required": ["from", "service", "date", "said"]
      }
    },
    "properties": {
      "deck": {},
      "scn": { "type": ["string", "null"] },
      "files": { "type": ["array", "null"], "items": { "$ref": "#/$defs/BundleFile" } },
      "theme": {}
    },
    "type": "object"
  }
}
