{
  "name": "background_set",
  "description": "Set a slide's background (PLAN 2.148): one of the theme's shader presets filling the canvas behind everything on `state`'s slide, entering in the slide's first state and kept to its slide, each shader that filled the canvas before taken away, and each text too faint to read over it set in the theme's color that reads there, as a re-theme sets it. Without `preset`, the slide's background is taken away. One patch, refused as `deck_patch` refuses one, reported as `deck_patch` reports one. Backgrounds stay off a slide that shows a chart or a table (W311): data reads against a plain surface.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "state"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "state": {
        "description": "A state of the slide: the background enters in the slide's first state and stays on it.",
        "type": "string"
      },
      "preset": {
        "description": "One of the theme's shader presets (`shaders.presets`: `backdrop`, `aurora`, `texture`,\n`haze`, `lagoon`, `sweep`, `dust` in the themes that ship). Without it, the slide's\nbackground is taken away.",
        "type": ["string", "null"],
        "default": null
      },
      "dry_run": { "description": "Say what would change, and write nothing.", "type": "boolean", "default": false }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      },
      "Fold": {
        "type": "object",
        "properties": {
          "into": { "type": "string" },
          "to": { "$ref": "#/$defs/FoldsTo" },
          "says": { "type": "string" }
        },
        "required": ["into", "to", "says"]
      },
      "FoldsTo": { "type": "string", "enum": ["place", "notes"] }
    },
    "required": ["applied", "patch", "added", "removed", "errors", "states"],
    "type": "object",
    "properties": {
      "applied": { "type": "boolean" },
      "patch": { "type": "array", "items": { "$ref": "#/$defs/JsonOp" } },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "states": { "type": "array", "items": { "type": "string" } },
      "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } },
      "folded": { "anyOf": [{ "$ref": "#/$defs/Fold" }, { "type": "null" }] }
    }
  }
}
