{
  "name": "deck_patch",
  "description": "Apply a patch: JSON Patch and semantic ops (add_node, rename_node, set_prop, set_text, show_node, hide_node, add_state, …; SPEC §7.3), all or none. A slide's own: move_slide, remove_slide, and duplicate_slide move, take away, and copy a slide with its steps and its beat; set_state sets a state's layout, transition, hold, or notes (`{\"op\": \"set_state\", \"id\": STATE, \"prop\": \"notes\", \"value\": \"…\"}`); place puts a node where it goes; choose sets a property where its value lives; replace_text changes words, keeping their runs. An op that does not read says the shape it is written in, and the skill `scaena://skills/author-deck` writes every op so. A patch that would make the deck invalid is refused. Reports the semantic ops given, what changed in the slides and the story (`summary`: slides and beats added, removed, and moved, and beats told otherwise), and what lint finds that it did not (`added`) and finds no more (`removed`); with `verbose`, the patch compiled to JSON Patch too. Each beat whose claim a slide said before and says no more is `restated`, with a `fix` that sets the claim to the slide's words, or none where its headline was taken away: restate the claim, or ask the user.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "ops"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "ops": {
        "description": "The ops, in order: JSON Patch (RFC 6902) and semantic ops (SPEC §7.3,\n`scaena://schema/patch`). All apply, or none.",
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      },
      "dry_run": { "description": "Say what would change, and write nothing.", "type": "boolean", "default": false },
      "verbose": {
        "description": "The patch compiled to JSON Patch too (`patch`), which a structural op makes long.",
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Summary": {
        "type": "object",
        "properties": {
          "json_patch": { "type": "integer", "minimum": 0 },
          "slides_added": { "type": "array", "items": { "type": "string" } },
          "slides_removed": { "type": "array", "items": { "type": "string" } },
          "slides_moved": { "type": "array", "items": { "type": "string" } },
          "beats_added": { "type": "array", "items": { "type": "string" } },
          "beats_removed": { "type": "array", "items": { "type": "string" } },
          "beats_moved": { "type": "array", "items": { "type": "string" } },
          "beats_changed": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "json_patch",
          "slides_added",
          "slides_removed",
          "slides_moved",
          "beats_added",
          "beats_removed",
          "beats_moved",
          "beats_changed"
        ]
      },
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      }
    },
    "required": ["applied", "summary", "added", "removed", "errors", "states", "restated"],
    "type": "object",
    "properties": {
      "applied": { "type": "boolean" },
      "ops": { "type": ["array", "null"], "items": true },
      "summary": { "$ref": "#/$defs/Summary" },
      "patch": { "type": ["array", "null"], "items": { "$ref": "#/$defs/JsonOp" } },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "states": { "type": "array", "items": { "type": "string" } },
      "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } }
    }
  }
}
