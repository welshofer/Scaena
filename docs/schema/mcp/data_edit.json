{
  "name": "data_edit",
  "description": "A data source's rows (SPEC §3.10). With no `edits`, the source as a sheet: its columns, each one's type, its rows as written, by index from 0, and the cells a column does not read. With them, cells set (`set`), rows added (`add`, at `row` or the end) and taken away (`remove`), in order, all or none: one write of the source's file that keeps every other byte, or a patch of rows written inline, and what that changes in what lint finds. A value its column's type refuses stops them, by index (`op`); edits that would leave the deck invalid are refused (`refused`, and why in `added`). Every chart and table that reads the source reads it changed.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "RowEdit": {
        "description": "An edit of a data source's rows. Row 0 is the first after the header.",
        "oneOf": [
          {
            "description": "`column` of row `row`, set to `value` as typed: a number, `true` or `false`, a date as the\ncolumn's `parse` format or ISO 8601 reads it, or any text. Empty, or null, is nothing.",
            "type": "object",
            "properties": {
              "row": { "type": "integer", "minimum": 0 },
              "column": { "type": "string" },
              "value": { "type": ["string", "number", "boolean", "null"] },
              "op": { "type": "string", "const": "set" }
            },
            "additionalProperties": false,
            "required": ["op", "row", "column", "value"]
          },
          {
            "description": "A row added at `row`, the rows from there on after it; at the end without it. Each column\nis its value in `values`, as typed, or nothing.",
            "type": "object",
            "properties": {
              "row": { "type": ["integer", "null"], "minimum": 0 },
              "values": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean", "null"] },
                "default": {}
              },
              "op": { "type": "string", "const": "add" }
            },
            "additionalProperties": false,
            "required": ["op"]
          },
          {
            "description": "Row `row` taken away.",
            "type": "object",
            "properties": { "row": { "type": "integer", "minimum": 0 }, "op": { "type": "string", "const": "remove" } },
            "additionalProperties": false,
            "required": ["op", "row"]
          }
        ]
      }
    },
    "required": ["bundle", "source"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "source": { "description": "The source's id: what a chart or a table names as `@id`.", "type": "string" },
      "edits": {
        "description": "The edits, made in order, all or none: each names a row as the edits before it leave the\nrows. With none, the source is read, and nothing is written.",
        "type": "array",
        "items": { "$ref": "#/$defs/RowEdit" },
        "default": []
      },
      "dry_run": { "description": "Say what would change, and write nothing.", "type": "boolean", "default": false }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Sheet": {
        "type": "object",
        "properties": {
          "columns": { "type": "array", "items": { "$ref": "#/$defs/SheetColumn" } },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
          "problems": { "type": "array", "items": { "$ref": "#/$defs/CellProblem" } }
        },
        "required": ["columns", "rows"]
      },
      "SheetColumn": {
        "type": "object",
        "properties": { "name": { "type": "string" }, "type": { "$ref": "#/$defs/ColumnType" } },
        "required": ["name", "type"]
      },
      "ColumnType": { "type": "string", "enum": ["number", "string", "boolean", "date"] },
      "CellProblem": {
        "type": "object",
        "properties": {
          "row": { "type": "integer", "minimum": 0 },
          "column": { "type": "string" },
          "why": { "type": "string" }
        },
        "required": ["row", "column", "why"]
      },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] }
    },
    "required": ["edited", "source", "sheet", "added", "removed", "errors", "refused"],
    "type": "object",
    "properties": {
      "edited": { "type": "boolean" },
      "source": { "type": "string" },
      "file": { "type": ["string", "null"] },
      "sheet": { "$ref": "#/$defs/Sheet" },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "refused": { "type": "boolean" },
      "quoted": { "type": "array", "items": { "type": "string" } },
      "unquoted": { "type": "array", "items": { "type": "string" } }
    }
  }
}
