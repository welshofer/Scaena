{
  "name": "data_attach",
  "description": "Attach a CSV or JSON data file: copy it into the bundle's `data/` and declare it as a source charts and tables name as `@id`, each column typed (inferred from its values without `schema`).",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "id", "file"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "id": { "description": "The source's id, which charts and tables name as `@id`.", "type": "string" },
      "file": { "description": "The CSV or JSON file (an array of objects) to copy in.", "type": "string" },
      "schema": {
        "description": "Each column's type: `number`, `string`, `date`, or `boolean`. Without it, each is\ntyped as narrowly as all its values allow, a date in ISO 8601.",
        "type": ["object", "null"],
        "additionalProperties": { "type": "string" }
      },
      "parse": {
        "description": "A date column's format, for dates not in ISO 8601 (`docs/spec/format.md`).",
        "type": ["object", "null"],
        "additionalProperties": { "type": "string" }
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] }
    },
    "required": ["attached", "id", "source", "schema", "rows", "added", "removed", "errors"],
    "type": "object",
    "properties": {
      "attached": { "type": "boolean" },
      "id": { "type": "string" },
      "source": { "type": "string" },
      "schema": { "type": "object", "additionalProperties": { "type": "string" } },
      "rows": { "type": "integer", "minimum": 0 },
      "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 }
    }
  }
}
