{
  "name": "deck_lint",
  "description": "Lint the bundle (SPEC §7.5): validation, the document rules, then layout, contrast, motion, and narrative in every format it lists. Findings carry a JSON pointer, and a fix when one is safe; `fix` applies them.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "SeverityArg": {
        "description": "The least severity to report.",
        "type": "string",
        "enum": ["error", "warning", "info"]
      }
    },
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "state": {
        "description": "Only the findings in this state, laying out it alone, a finding that holds there from an\nearlier state reported at it; with `fix`, only its fixes.",
        "type": ["string", "null"],
        "default": null
      },
      "severity": { "$ref": "#/$defs/SeverityArg" },
      "fix": {
        "description": "Apply the fixes lint offers (each checked by laying its state out again; never a\nchange of content), write the deck, and lint again.",
        "type": "boolean",
        "default": false
      },
      "now": {
        "description": "The moment to judge dates at (W428: a forecast that has passed): an instant, as\n2026-10-15T20:00:00Z, or a day, as 2026-10-15. Without it, no date is judged.",
        "type": ["string", "null"],
        "default": null
      }
    },
    "additionalProperties": false,
    "required": ["bundle"]
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] }
    },
    "type": "object",
    "properties": {
      "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
      "fixed": { "type": ["array", "null"], "items": { "$ref": "#/$defs/Finding" } },
      "errors": { "type": "integer", "minimum": 0 },
      "laid": { "type": "boolean" }
    },
    "required": ["findings", "errors", "laid"]
  }
}
