{
  "name": "deck_find",
  "description": "Find text across the deck's words, in every state (PLAN 2.47, 2.83): its texts, each node's description (`alt`), each state's notes, each beat's claim and notes, the titles and notes a chart or a table draws, and the string values of its data (`kind`), once for each place they are written (the node's own, a state's delta, the deck's overrides, a state, a beat, or a data source), with the states that show them from there and each match, in characters. With `replace`, every match is replaced in one patch, a `replace_text` where each text lives and a JSON Patch `replace` of the rest where they are written, reported as `deck_patch` reports a patch (`replaced`); a value of the data (a cell, or a value a highlight picks out) is found and left as it is, where it stands listed in `kept`, for `data_edit`.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle", "find"],
    "type": "object",
    "properties": {
      "bundle": { "description": "The bundle: a directory, a `.scaena` zip, or a `deck.json`.", "type": "string" },
      "find": { "description": "The characters sought, as typed.", "type": "string" },
      "case": { "description": "Upper and lower case apart; alike without it.", "type": "boolean", "default": false },
      "words": {
        "description": "Whole words only: a match that neither begins nor ends inside a word.",
        "type": "boolean",
        "default": false
      },
      "replace": {
        "description": "Replace every match with this, in one patch: a `replace_text` where each text lives.",
        "type": ["string", "null"],
        "default": null
      },
      "dry_run": {
        "description": "With `replace`: say what would change, and write nothing.",
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Found": {
        "type": "object",
        "properties": {
          "kind": { "$ref": "#/$defs/Kind", "default": "text" },
          "node": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "file": { "type": ["string", "null"] },
          "kept": { "type": ["string", "null"] },
          "beat": { "type": ["string", "null"] },
          "state": { "type": "string" },
          "states": { "type": "array", "items": { "type": "string" } },
          "lives": { "type": "string" },
          "text": { "type": "string" },
          "matches": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }
          }
        },
        "required": ["state", "states", "lives", "text", "matches"]
      },
      "Kind": {
        "oneOf": [
          { "type": "string", "const": "text" },
          { "type": "string", "const": "alt" },
          { "type": "string", "const": "notes" },
          { "type": "string", "const": "claim" },
          { "type": "string", "const": "chart" },
          { "type": "string", "const": "data" }
        ]
      },
      "Patched": {
        "type": "object",
        "properties": {
          "applied": { "type": "boolean" },
          "patch": { "type": "array", "items": { "$ref": "#/$defs/JsonOp" } },
          "added": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "removed": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
          "errors": { "type": "integer", "minimum": 0 },
          "states": { "type": "array", "items": { "type": "string" } },
          "restated": { "type": "array", "items": { "$ref": "#/$defs/Restated" } }
        },
        "required": ["applied", "patch", "added", "removed", "errors", "states"]
      },
      "JsonOp": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "add" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": { "path": { "$ref": "#/$defs/Pointer" }, "op": { "type": "string", "const": "remove" } },
            "required": ["op", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "replace" }
            },
            "required": ["op", "path", "value"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "move" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "from": { "$ref": "#/$defs/Pointer" },
              "path": { "$ref": "#/$defs/Pointer" },
              "op": { "type": "string", "const": "copy" }
            },
            "required": ["op", "from", "path"]
          },
          {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/Pointer" },
              "value": true,
              "op": { "type": "string", "const": "test" }
            },
            "required": ["op", "path", "value"]
          }
        ]
      },
      "Pointer": { "type": "string", "pattern": "^(/.*)?$" },
      "Finding": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "$ref": "#/$defs/Severity" },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "path": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "node": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "measure": true,
          "hint": { "type": ["string", "null"] },
          "fix": { "type": ["array", "null"], "items": true },
          "refresh": { "type": ["string", "null"] }
        },
        "required": ["code", "severity", "message"]
      },
      "Severity": { "type": "string", "enum": ["info", "warning", "error"] },
      "Restated": {
        "type": "object",
        "properties": {
          "beat": { "type": "string" },
          "state": { "type": "string" },
          "path": { "type": "string" },
          "claim": { "type": "string" },
          "says": { "type": ["string", "null"] },
          "fix": { "type": "array", "items": true }
        },
        "required": ["beat", "state", "path", "claim"]
      }
    },
    "required": ["found", "matches"],
    "type": "object",
    "properties": {
      "found": { "type": "array", "items": { "$ref": "#/$defs/Found" } },
      "matches": { "type": "integer", "minimum": 0 },
      "replaced": { "anyOf": [{ "$ref": "#/$defs/Patched" }, { "type": "null" }] },
      "kept": { "type": "array", "items": { "type": "string" } }
    }
  }
}
