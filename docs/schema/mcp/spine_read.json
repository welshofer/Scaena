{
  "name": "spine_read",
  "description": "The deck's spine (SPEC §2.6, §10): its sections and beats, each beat's claim, evidence, and states, and the state that shows it. `deck_export` with `spine` also places it on the timeline and draws each beat.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "required": ["bundle"],
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "bundle": {
        "description": "The bundle's path: a directory, a `.scaena` zip, or a `deck.json`.",
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Spine": {
        "type": "object",
        "properties": { "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } } },
        "additionalProperties": false,
        "required": ["sections"]
      },
      "Section": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/Id" },
          "title": { "type": ["string", "null"] },
          "beats": { "type": "array", "items": { "$ref": "#/$defs/Beat" }, "minItems": 1 }
        },
        "additionalProperties": false,
        "required": ["id", "beats"]
      },
      "Id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "Beat": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/Id" },
          "claim": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "states": { "$ref": "#/$defs/IdList" },
          "notes": { "type": ["string", "null"] },
          "duration": { "type": ["number", "null"], "minimum": 0 },
          "media": { "type": ["object", "null"], "additionalProperties": true }
        },
        "additionalProperties": false,
        "required": ["id", "claim"]
      },
      "IdList": { "type": "array", "items": { "$ref": "#/$defs/Id" }, "uniqueItems": true },
      "Pace": { "oneOf": [{ "type": "string", "const": "beats" }, { "type": "string", "const": "holds" }] },
      "SpineState": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slide": { "type": "string" },
          "notes": { "type": ["string", "null"] },
          "hold": { "type": ["number", "null"] },
          "rest": { "type": ["number", "null"] },
          "start": { "type": ["number", "null"] },
          "span": { "type": ["number", "null"] }
        },
        "additionalProperties": false,
        "required": ["id", "slide"]
      },
      "SpineBeat": {
        "type": "object",
        "properties": {
          "section": { "type": "string" },
          "state": { "type": ["string", "null"] },
          "start": { "type": ["number", "null"] },
          "end": { "type": ["number", "null"] },
          "thumbnail": { "type": ["string", "null"] },
          "formats": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false,
        "required": ["section"]
      }
    },
    "required": ["scaena", "canvas", "states"],
    "type": "object",
    "properties": {
      "scaena": { "type": "string" },
      "title": { "type": ["string", "null"] },
      "lang": { "type": ["string", "null"] },
      "canvas": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
      "formats": { "type": "array", "items": { "type": "string" }, "default": [] },
      "spine": { "anyOf": [{ "$ref": "#/$defs/Spine" }, { "type": "null" }] },
      "pace": { "anyOf": [{ "$ref": "#/$defs/Pace" }, { "type": "null" }] },
      "states": { "type": "array", "items": { "$ref": "#/$defs/SpineState" } },
      "beats": { "type": "object", "additionalProperties": { "$ref": "#/$defs/SpineBeat" }, "default": {} }
    },
    "additionalProperties": false
  }
}
