    "color": {
      "ink": "#16140F",
      "paper": "#FBFAF6",
      "paper-2": "#F1EEE6",
      "accent": "#C2410C",
      "muted": "#6B675E",
      "line": "#DAD5C9"
    },
    "roles": {
      "surface": "paper",
      "surface-2": "paper-2",
      "onSurface": "ink",
      "onSurfaceMuted": "muted",
      "accent": "accent",
      "onAccent": "paper",
      "line": "line"
    },
    "data": {
      "categorical": [
        "#C2410C",
        "#0F766E",
        "#4338CA",
        "#A16207",
        "#BE185D",
        "#15803D"
      ],
