  "grid": {
    "columns": 12,
    "rows": 8,
    "gutter": 24,
    "margin": 96,
    "baseline": 8
  },
  "layouts": {
    "title": {
      "description": "Opening title.",
      "slots": {
        "title": {
          "col": [
            1,
            10
          ],
          "row": [
            3,
            5
          ],
          "role": "display",
          "align": {
            "x": "start",
            "y": "cap"
          }
        },
        "subtitle": {
          "col": [
            1,
            8
          ],
          "row": 6,
          "role": "body"
        }
      }
    },
    "full": {
      "description": "One thing, full bleed to the grid.",
      "slots": {
        "main": {
          "col": [
            1,
            12
          ],
          "row": [
            1,
            8
          ]
        },
        "header": {
          "col": [
            1,
            12
          ],
          "row": [
            1,
            2
          ],
          "role": "headline"
        },
        "footer": {
          "col": [
            1,
            12
          ],
          "row": 8,
          "role": "caption"
        }
      }
    },
    "specimen": {
      "description": "A case label on row 1; specimens placed on grid rows 2-8.",
      "slots": {
        "case": {
          "col": [
            1,
            12
          ],
          "row": 1,
          "role": "label",
          "align": {
            "x": "start",
            "y": "cap"
          }
        },
        "main": {
          "col": [
            1,
            12
          ],
          "row": [
            2,
            8
          ]
        }
      }
    }
