  "motion": {
    "durations": {
      "fast": 180,
      "standard": 420,
      "slow": 800
    },
    "easings": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "in": [
        0.4,
        0,
        1,
        1
      ],
      "out": [
        0,
        0,
        0.2,
        1
      ],
      "linear": [
        0,
        0,
        1,
        1
      ]
    },
    "springs": {
      "snappy": {
        "stiffness": 420,
        "damping": 34,
        "mass": 1
      },
      "gentle": {
        "stiffness": 170,
        "damping": 26,
        "mass": 1
      }
    },
    "presets": {
      "fade": {
        "from": {
          "opacity": 0
        },
        "duration": "standard",
        "ease": "out"
      },
      "rise": {
        "from": {
          "opacity": 0,
          "transform": {
            "translate": [
              0,
              24
            ]
          }
        },
        "duration": "standard",
        "ease": "out"
      },
      "grow": {
        "from": {
          "transform": {
            "scale": [
              1,
              0
            ],
            "anchor": [
              0.5,
              1
            ]
          }
        },
        "spring": "snappy",
        "split": "marks",
        "stagger": 40
      }
    },
    "maxConcurrent": 12,
    "maxBuild": 2500
  },
  "shaders": {
    "palettes": {
      "torture": [
        "#0F766E",
        "#4338CA",
        "#C2410C",
        "#F5C451"
      ]
    }
  },
  "charts": {
    "axis": {
      "role": "label",
      "stroke": "hairline",
      "color": "line"
    },
    "gridlines": {
      "stroke": "hairline",
      "color": "line",
      "opacity": 0.6
    },
    "label": {
      "role": "label"
    },
    "strokeWidth": "thin",
    "cornerRadius": 2,
    "barGap": 0.28
  },
  "density": {
    "maxWordsPerState": 60
  }
}
