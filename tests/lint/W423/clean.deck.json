{
  "scaena": "0.40",
  "_comment": "W423 clean: a chart reads @sales in the first beat's state, and a text quotes one of its cells in the second's.",
  "canvas": {"width": 1920, "height": 1080},
  "theme": "theme.json",
  "fonts": [{"family": "Roboto Serif", "file": "fonts/RobotoSerif-VF.ttf"}, {"family": "EB Garamond", "file": "fonts/EBGaramond-VF.ttf"}],
  "data": {"sales": {"source": "data/sales.csv", "schema": {"revenue": "number"}}},
  "spine": {"sections": [{"id": "only", "beats": [{"id": "one", "claim": "Revenue doubled", "evidence": ["@sales", "source:field-notes.md", "https://example.org/report"], "states": ["a"]}, {"id": "two", "claim": "Pro reached 19", "evidence": ["@sales"], "states": ["b"]}]}]},
  "nodes": {
    "c": {"type": "text", "role": "headline", "text": "Revenue doubled", "semantic": "claim", "at": {"in": "header"}},
    "k": {"type": "chart", "kind": "bar", "data": "@sales", "x": {"field": "quarter"}, "y": {"field": "revenue"}, "series": {"field": "product"}, "alt": "Revenue by quarter and product.", "semantic": "evidence", "at": {"in": "main"}},
    "q": {"type": "text", "role": "headline", "runs": [{"text": "Pro reached "}, {"text": "19", "quote": {"data": "@sales", "row": {"quarter": "Q4", "product": "Pro"}, "column": "revenue"}}], "semantic": "claim", "at": {"in": "header"}}
  },
  "states": [
    {"id": "a", "layout": "figure", "props": {"c": {}, "k": {}}},
    {"id": "b", "mode": "absolute", "layout": "figure", "props": {"q": {}}}
  ]
}
