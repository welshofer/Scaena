{
  "scaena": "0.15",
  "_comment": "W311 trigger: a mesh behind the whole canvas, under a bar chart.",
  "canvas": {"width": 1920, "height": 1080},
  "theme": "theme.json",
  "fonts": [{"family": "Roboto Serif", "file": "fonts/RobotoSerif-VF.ttf"}, {"family": "EB Garamond", "file": "fonts/EBGaramond-VF.ttf"}],
  "data": {"sales": {"source": {"inline": [{"q": "Q1", "v": 10}, {"q": "Q2", "v": 12}, {"q": "Q3", "v": 15}]}, "schema": {"v": "number"}}},
  "nodes": {
    "bg": {"type": "shader", "kind": "mesh", "seed": 7, "palette": "ambient", "at": {"in": "canvas"}},
    "c": {"type": "chart", "kind": "bar", "data": "@sales", "x": {"field": "q"}, "y": {"field": "v"}, "alt": "Sales rise each quarter.", "at": {"in": "main"}}
  },
  "states": [
    {"id": "a", "layout": "full", "props": {"bg": {}, "c": {}}}
  ]
}
