{
  "scaena": "0.14",
  "_comment": "E102 trigger: E102/clean.deck.json with every kind of reference broken once, and a node placed in rows 6–7 of a 6-row grid.",
  "canvas": { "width": 1920, "height": 1080 },
  "theme": "theme.json",
  "fonts": [
    { "family": "Display", "file": "fonts/Display.ttf" },
    { "family": "Body", "file": "fonts/Body.ttf" }
  ],
  "data": { "q3": { "source": "data/q3-final.csv" } },
  "nodes": {
    "bg": { "type": "shader", "kind": "mesh", "palette": "sunset", "at": { "in": "canvas" } },
    "title": { "type": "text", "role": "headlin", "style": { "family": "sans", "color": "inkk" }, "text": "Q3 Review", "at": { "in": "title" }, "fill": "acent", "enter": "slide" },
    "chart": { "type": "chart", "kind": "bar", "data": "@q4", "x": { "field": "quarter" }, "y": { "field": "revenue" }, "labels": { "show": "ends", "role": "figure" } },
    "photo": { "type": "image", "src": "assets/team.png", "alt": "The team at launch", "at": { "in": "main" } },
    "stats": { "type": "stack", "axis": "x", "at": { "in": "main" } },
    "figure": { "type": "text", "text": "42%", "at": { "parent": "stat" } },
    "note": { "type": "text", "text": "Up from 38%", "at": { "parent": "stats" } },
    "board": { "type": "grid", "areas": ["head head", "left right"], "at": { "in": "main" } },
    "cell": { "type": "text", "text": "Q3", "at": { "parent": "board", "area": "side" } },
    "late": { "type": "text", "text": "Q4", "at": { "col": [1, 12], "row": [6, 7] } }
  },
  "states": [
    { "id": "intro", "layout": "titel", "props": { "bg": {}, "title": {} } },
    {
      "id": "numbers",
      "layout": "full",
      "transition": { "duration": "medium", "ease": "bouncy" },
      "props": { "title": { "at": { "in": "header" } }, "chart": { "at": { "in": "main" } }, "note": {} },
      "choreography": [ { "target": "chart", "enter": { "preset": "pop", "spring": "springy" } }, { "target": "ghost", "enter": "fade" } ]
    },
    { "id": "photo", "slide": "numbrs", "layout": "full", "remove": ["chart", "note"], "props": { "photo": {}, "stats": {}, "figure": {}, "board": {}, "cell": {}, "late": {} } }
  ],
  "overrides": { "ghost": { "opacity": 0.5 }, "chart": { "labels": { "role": "figures" } } }
}
